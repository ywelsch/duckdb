# name: test/sql/tpch/dbgen_checkpoint_lock.test
# description: dbgen in a transaction that is open across a checkpoint, and replay from the WAL
# group: [tpch]

require tpch

require skip_reload

load {TEST_DIR}/dbgen_checkpoint_lock.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

statement ok con1
BEGIN TRANSACTION

statement ok con1
CALL dbgen(sf=0.01)

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

statement ok con1
COMMIT

restart

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM lineitem
----
60175

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT
