# name: test/sql/alter/test_alter_concurrent_conflict.test
# description: ALTERs next to another transaction's uncommitted change to the same table
# group: [alter]

statement ok
CREATE TABLE t (i INTEGER, c INTEGER)

statement ok con1
BEGIN

statement ok con1
COMMENT ON TABLE t IS 'x'

# an ALTER that has nothing to do does not conflict
statement ok con2
ALTER TABLE t ADD COLUMN IF NOT EXISTS c INTEGER

statement ok con2
ALTER TABLE t DROP COLUMN IF EXISTS d

statement ok con1
COMMIT

statement ok con1
BEGIN

statement ok con1
ALTER TABLE t ALTER i SET DEFAULT 5

statement error con2
ALTER TABLE t ALTER c TYPE BIGINT
----
write-write conflict

# the conflicting ALTER gave the table back, so the other transaction keeps writing it
statement ok con1
INSERT INTO t (c) VALUES (3)

statement ok con1
COMMIT

statement ok con2
INSERT INTO t (c) VALUES (4)

query II
SELECT i, c FROM t ORDER BY c
----
5	3
5	4
