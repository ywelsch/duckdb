# name: test/sql/alter/alter_type/test_alter_type_failure.test
# description: An ALTER that fails to compute its column leaves the table as it was, also for other connections
# group: [alter_type]

require json

statement ok
CREATE TABLE t AS SELECT i::VARCHAR AS v FROM range(300000) t(i)

statement ok
INSERT INTO t VALUES ('x')

statement ok con1
BEGIN

statement error con1
ALTER TABLE t ALTER v TYPE BIGINT
----
Could not convert

statement error con1
SELECT COUNT(*) FROM t
----
Current transaction is aborted

# the failed ALTER installed nothing, so other connections write the table before the rollback
statement ok con2
INSERT INTO t VALUES ('y')

statement ok con1
ROLLBACK

statement ok con1
BEGIN

statement error con1
ALTER TABLE t ADD COLUMN c INTEGER DEFAULT CAST('abc' AS INTEGER)
----
Could not convert

statement ok con2
INSERT INTO t VALUES ('z')

statement ok con1
ROLLBACK

query II
SELECT COUNT(*), (SELECT COUNT(*) FROM duckdb_columns() WHERE table_name = 't') FROM t
----
300003	1

# a constraint the computed column violates fails after the appended rows moved to the new table version
statement ok
CREATE TABLE n (v VARCHAR NOT NULL)

statement ok con1
BEGIN

statement ok con1
INSERT INTO n VALUES ('a')

statement error con1
ALTER TABLE n ALTER v TYPE INTEGER USING NULL
----
NOT NULL constraint failed

statement ok con1
ROLLBACK

statement ok con2
INSERT INTO n VALUES ('b')

query I
SELECT v FROM n
----
b

# a parser error does not invalidate a transaction under this policy, and the failed ALTER left nothing behind
statement ok
CREATE TABLE j AS SELECT '{}'::JSON AS j FROM range(10)

statement ok con1
SET default_transaction_invalidation_policy='SYNTACTIC_ERRORS_DO_NOT_INVALIDATE'

statement ok con1
BEGIN

statement error con1
ALTER TABLE j ALTER j TYPE VARCHAR USING json_deserialize_sql(j)
----
Error parsing json

query II con1
SELECT COUNT(*), typeof(ANY_VALUE(j)) FROM j
----
10	JSON

statement ok con1
COMMIT

query II
SELECT COUNT(*), typeof(ANY_VALUE(j)) FROM j
----
10	JSON
