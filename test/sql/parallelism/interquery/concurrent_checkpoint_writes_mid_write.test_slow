# name: test/sql/parallelism/interquery/concurrent_checkpoint_writes_mid_write.test_slow
# description: Inserts, deletes and updates hitting a table while a checkpoint writes it
# group: [interquery]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

foreach scan_sleep 0 20 100

statement ok
SET debug_checkpoint_scan_sleep_ms={scan_sleep}

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_mid_write{scan_sleep}.db' AS ccw

statement ok
CREATE TABLE ccw.integers AS SELECT i, i AS j, 'str' || i AS s FROM range(20000) t(i)

statement ok
CHECKPOINT ccw

concurrentloop threadid 0 20

loop x 0 10

# threads 0-9 update their own 1000 rows ten times
onlyif threadid<10
statement ok
UPDATE ccw.integers SET j = j + 1, s = s || 'x' WHERE i >= {threadid} * 1000 AND i < ({threadid} + 1) * 1000

# threads 11-15 append 100 rows per iteration
onlyif threadid>10&&threadid<16
statement ok
INSERT INTO ccw.integers SELECT i, i, 'str' || i FROM range(100000 + {threadid} * 10000 + {x} * 100, 100000 + {threadid} * 10000 + ({x} + 1) * 100) t(i)

# threads 16-19 delete 100 of their own rows per iteration
onlyif threadid>=16
statement ok
DELETE FROM ccw.integers WHERE i >= {threadid} * 1000 + {x} * 100 AND i < {threadid} * 1000 + ({x} + 1) * 100

endloop

# thread 10 checkpoints while the others modify the table
loop x 0 5

onlyif threadid=10
statement ok
CHECKPOINT ccw

endloop

endloop

# 20000 original rows + 5 threads * 10 * 100 inserted - 4 threads * 10 * 100 deleted
# 10 threads * 10 iterations * 1000 rows incremented once each
query IIIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	100000	100000	0	true

statement ok
DETACH ccw

# replay the WAL of the commits that ran concurrently with the checkpoints
statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_mid_write{scan_sleep}.db' AS ccw

query IIIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	100000	100000	0	true

statement ok
CHECKPOINT ccw

statement ok
DETACH ccw

statement ok
ATTACH '{TEST_DIR}/concurrent_checkpoint_writes_mid_write{scan_sleep}.db' AS ccw

query IIIII
SELECT COUNT(*), SUM(j - i), SUM(length(s) - length('str' || i)), COUNT(*) FILTER (WHERE i >= 16000 AND i < 20000), COUNT(*) = COUNT(DISTINCT rowid) FROM ccw.integers
----
21000	100000	100000	0	true

statement ok
DETACH ccw

endloop
