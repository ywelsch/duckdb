# name: test/sql/parallelism/interquery/concurrent_alter_append_transaction.test_slow
# description: ALTER TABLE in an explicit transaction concurrent with committing INSERTs must not corrupt the table
# group: [interquery]

# The transaction does its own scans and appends on the altered table. This exercises the
# window where the transaction keeps using the altered table state between the ALTER statement
# and the COMMIT: the ALTER must never base that state on rows whose commit is still in flight.

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '__TEST_DIR__/concurrent_alter_append_txn.db' AS caa

statement ok
CREATE TABLE caa.t AS SELECT range::INTEGER AS int_col, md5(range::VARCHAR)::VARCHAR AS varchar_col FROM range(200)

concurrentloop threadid 0 2

loop x 0 100

# thread 0: the dbt column-rename pattern inside an explicit transaction, including an append of its own;
# each statement may hit a (clean) transaction conflict, which aborts the transaction
onlyif threadid=0
statement maybe
BEGIN
----

onlyif threadid=0
statement maybe
ALTER TABLE caa.t ADD COLUMN IF NOT EXISTS int_col__tmp INTEGER
----

onlyif threadid=0
statement maybe
UPDATE caa.t SET int_col__tmp = int_col
----

onlyif threadid=0
statement maybe
INSERT INTO caa.t BY NAME SELECT 1::INTEGER AS int_col, 'x' AS varchar_col FROM range(10)
----

onlyif threadid=0
statement maybe
ALTER TABLE caa.t DROP COLUMN int_col__tmp
----

onlyif threadid=0
statement maybe
COMMIT
----

# clear any aborted transaction state (errors with "no transaction is active" if the commit succeeded)
onlyif threadid=0
statement maybe
ROLLBACK
----

# thread 1: concurrent appends
onlyif threadid=1
statement maybe
INSERT INTO caa.t BY NAME SELECT 1::INTEGER AS int_col, 'x' AS varchar_col FROM range(10)
----

endloop

endloop

# integrity invariants: every base row has a 32-char md5 and int_col 0..199 (sum 19900),
# every committed inserted batch (from either thread) adds 10 rows with varchar length 1 and int_col 1
# a full scan of the (previously corruptible) varchar column must succeed and match the row count
query I
SELECT CASE WHEN count(*) % 10 = 0
            AND sum(length(varchar_col)) = 6400 + (count(*) - 200)
            AND sum(int_col) = 19900 + (count(*) - 200)
       THEN 'ok' ELSE concat('MISMATCH: ', count(*), ' ', sum(length(varchar_col)), ' ', sum(int_col)) END
FROM caa.t
----
ok

# the WAL must replay cleanly and yield the same consistent table
statement ok
DETACH caa

statement ok
ATTACH '__TEST_DIR__/concurrent_alter_append_txn.db' AS caa

query I
SELECT CASE WHEN count(*) % 10 = 0
            AND sum(length(varchar_col)) = 6400 + (count(*) - 200)
            AND sum(int_col) = 19900 + (count(*) - 200)
       THEN 'ok' ELSE concat('MISMATCH: ', count(*), ' ', sum(length(varchar_col)), ' ', sum(int_col)) END
FROM caa.t
----
ok

statement ok
DETACH caa
