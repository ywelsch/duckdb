# name: test/sql/storage/rowid_gaps/trailing_rowid_gap.test
# description: Row ids behind the last row group stay in use after a checkpoint dropped the row groups that held them
# group: [rowid_gaps]

require skip_reload

statement ok
PRAGMA disable_checkpoint_on_shutdown;

statement ok
SET wal_autocheckpoint='1TB';

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap.db' AS gap (STORAGE_VERSION 'v2.1.0', ROW_GROUP_SIZE 2048);

statement ok
CREATE TABLE gap.t (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
CREATE TABLE gap.u (i BIGINT);

statement ok
CREATE TABLE gap.e (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
CREATE TABLE gap.p (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
CREATE TABLE gap.q (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
CREATE TABLE gap.r (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
CREATE TABLE gap.c1 (i BIGINT PRIMARY KEY);

statement ok
CREATE TABLE gap.c2 (i BIGINT PRIMARY KEY);

# three row groups each
foreach tbl t e p q r

statement ok
INSERT INTO gap.{tbl} SELECT i, 'base' FROM range(6144) tbl(i);

endloop

statement ok
INSERT INTO gap.u SELECT i FROM range(6144) tbl(i);

statement ok
CHECKPOINT gap;

foreach tbl t u p q r

statement ok
DELETE FROM gap.{tbl} WHERE i >= 4096;

endloop

statement ok
DELETE FROM gap.e;

# the checkpoint drops the deleted row groups
statement ok
CHECKPOINT gap;

foreach tbl t u p q r

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('gap.{tbl}');
----
2

endloop

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('gap.e');
----
0

statement ok
DETACH gap;

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap.db' AS gap (ROW_GROUP_SIZE 2048);

# a checkpoint that does not rewrite the tables keeps their next row id
statement ok
INSERT INTO gap.c1 VALUES (0);

statement ok
CHECKPOINT gap;

statement ok
DETACH gap;

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap.db' AS gap (ROW_GROUP_SIZE 2048);

# inserts continue behind the row ids of the dropped row groups
statement ok
INSERT INTO gap.t VALUES (10000, 'single');

query II
SELECT rowid, s FROM gap.t WHERE i = 10000;
----
6144	single

# also in a table that has no row groups left
statement ok
INSERT INTO gap.e VALUES (1, 'single'), (2, 'deleted');

query II
SELECT rowid, s FROM gap.e ORDER BY rowid;
----
6144	single
6145	deleted

# and for row groups that are moved over from the transaction
statement ok
INSERT INTO gap.u SELECT i FROM range(30000, 35000) tbl(i);

query III
SELECT min(rowid), max(rowid), count(*) FROM gap.u WHERE i >= 30000;
----
6144	11143	5000

# a commit that fails after it appended to the tables leaves their next row id alone
statement ok con1
BEGIN

statement ok con1
INSERT INTO gap.p VALUES (5000, 'loser');

statement ok con1
INSERT INTO gap.q VALUES (5000, 'loser');

statement ok con1
INSERT INTO gap.r VALUES (5000, 'loser');

statement ok con1
INSERT INTO gap.c1 VALUES (1);

statement ok con2
INSERT INTO gap.c1 VALUES (1);

statement error con1
COMMIT
----
<REGEX>:.*PRIMARY KEY or UNIQUE constraint violation.*

statement ok con1
BEGIN

statement ok con1
INSERT INTO gap.c2 VALUES (1);

statement ok con1
INSERT INTO gap.r VALUES (5000, 'loser');

statement ok con1
INSERT INTO gap.q VALUES (5000, 'loser');

statement ok con1
INSERT INTO gap.p VALUES (5000, 'loser');

statement ok con2
INSERT INTO gap.c2 VALUES (1);

statement error con1
COMMIT
----
<REGEX>:.*PRIMARY KEY or UNIQUE constraint violation.*

foreach tbl p q r

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('gap.{tbl}');
----
2

query II
SELECT max(rowid), count(*) FROM gap.{tbl};
----
4095	4096

statement ok
INSERT INTO gap.{tbl} VALUES (5000, 'single');

query II
SELECT rowid, s FROM gap.{tbl} WHERE i = 5000;
----
6144	single

endloop

# changes that address the inserted rows by row id
statement ok
DELETE FROM gap.e WHERE i = 2;

statement ok
UPDATE gap.t SET s = 'updated' WHERE i = 10000;

statement ok
DELETE FROM gap.u WHERE i >= 34000;

statement ok
DELETE FROM gap.p WHERE i = 5000;

# WAL replay assigns the same row ids
statement ok
DETACH gap;

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap.db' AS gap (ROW_GROUP_SIZE 2048);

query II
SELECT rowid, s FROM gap.t WHERE i = 10000;
----
6144	updated

query III
SELECT rowid, i, s FROM gap.e ORDER BY rowid;
----
6144	1	single

query III
SELECT min(rowid), max(rowid), count(*) FROM gap.u WHERE i >= 30000;
----
6144	10143	4000

query I
SELECT count(*) FROM gap.p WHERE i = 5000;
----
0

query II
SELECT rowid, s FROM gap.q WHERE i = 5000;
----
6144	single

statement ok
INSERT INTO gap.p VALUES (5000, 'again');

query II
SELECT rowid, s FROM gap.p WHERE i = 5000;
----
6145	again

statement ok
CHECKPOINT gap;

statement ok
DETACH gap;

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap.db' AS gap (ROW_GROUP_SIZE 2048);

query III
SELECT min(rowid), max(rowid), count(*) FROM gap.t;
----
0	6144	4097

query III
SELECT rowid, i, s FROM gap.e ORDER BY rowid;
----
6144	1	single

query III
SELECT min(rowid), max(rowid), count(*) FROM gap.u;
----
0	10143	8096

query II
SELECT rowid, s FROM gap.p WHERE i = 5000;
----
6145	again

# the indexes cover the rows on both sides of the gap
statement error
INSERT INTO gap.t VALUES (10000, 'duplicate');
----
<REGEX>:.*Constraint Error.*

statement error
INSERT INTO gap.t VALUES (4095, 'duplicate');
----
<REGEX>:.*Constraint Error.*

statement error
INSERT INTO gap.e VALUES (1, 'duplicate');
----
<REGEX>:.*Constraint Error.*

statement ok
INSERT INTO gap.e VALUES (2, 'again');

query II
SELECT rowid, s FROM gap.e WHERE i = 2;
----
6146	again

statement ok
DETACH gap;

# a database in memory keeps the row ids as well
statement ok
ATTACH ':memory:' AS mem_gap;

statement ok
CREATE TABLE mem_gap.t AS SELECT i FROM range(368640) tbl(i);

statement ok
DELETE FROM mem_gap.t WHERE i >= 245760;

statement ok
CHECKPOINT mem_gap;

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('mem_gap.t');
----
2

statement ok
INSERT INTO mem_gap.t VALUES (-1);

query I
SELECT rowid FROM mem_gap.t WHERE i = -1;
----
368640

# older storage versions do not keep row ids behind the last row group
statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap_old.db' AS old_gap (STORAGE_VERSION 'v2.0.0', ROW_GROUP_SIZE 2048);

statement ok
CREATE TABLE old_gap.t (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO old_gap.t SELECT i, 'base' FROM range(6144) tbl(i);

statement ok
CHECKPOINT old_gap;

statement ok
DELETE FROM old_gap.t WHERE i >= 4096;

statement ok
CHECKPOINT old_gap;

statement ok
INSERT INTO old_gap.t VALUES (10000, 'single');

query II
SELECT rowid, s FROM old_gap.t WHERE i = 10000;
----
4096	single

statement ok
DETACH old_gap;

statement ok
ATTACH '{TEST_DIR}/trailing_rowid_gap_old.db' AS old_gap (ROW_GROUP_SIZE 2048);

query II
SELECT rowid, s FROM old_gap.t WHERE i = 10000;
----
4096	single
