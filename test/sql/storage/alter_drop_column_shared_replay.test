# name: test/sql/storage/alter_drop_column_shared_replay.test
# description: Writes logged after a DROP COLUMN that was open during a checkpoint replay from the WAL
# group: [storage]

require skip_reload

load {TEST_DIR}/alter_drop_column_shared_replay.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

# merged by the checkpoint while the ALTER is open
statement ok
CREATE TABLE merged AS SELECT i, i::VARCHAR AS s, i * 2 AS x FROM range(400000) t(i)

# rewritten, not merged
statement ok
CREATE TABLE rewritten AS SELECT i, i::VARCHAR AS s, i * 2 AS x FROM range(1000) t(i)

statement ok
CREATE TABLE keyed (i INTEGER PRIMARY KEY, s VARCHAR, x INTEGER)

statement ok
INSERT INTO keyed SELECT i, i::VARCHAR, i * 2 FROM range(20000) t(i)

statement ok
CHECKPOINT

statement ok
DELETE FROM merged WHERE i < 300000 AND i % 10 <> 0

statement ok
DELETE FROM keyed WHERE i < 15000 AND i % 10 <> 0

statement ok
INSERT INTO rewritten SELECT i, i::VARCHAR, i * 2 FROM range(1000, 1100) t(i)

# nothing commits after the transactions start: the checkpoint is a full one
statement ok con1
BEGIN

statement ok con1
ALTER TABLE merged DROP COLUMN s

statement ok con1
ALTER TABLE rewritten DROP COLUMN s

statement ok con1
ALTER TABLE keyed DROP COLUMN s

statement ok
CHECKPOINT

statement ok con1
COMMIT

# written optimistically, with the hidden column, and logged as rows
statement ok
INSERT INTO merged SELECT i, i * 2 FROM range(600000, 800000) t(i)

# logged by row id after the checkpoint, replayed against what it wrote
foreach t merged rewritten keyed

statement ok
DELETE FROM {t} WHERE i % 20 = 0

statement ok
UPDATE {t} SET x = -x WHERE i % 30 = 0

statement ok
INSERT INTO {t} VALUES (500000, 7)

endloop

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM merged
----
300001	168500500000	322333866647

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM rewritten
----
1046	1074750	1110627

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM keyed
----
5501	89250000	164193327

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM merged
----
300001	168500500000	322333866647

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM rewritten
----
1046	1074750	1110627

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM keyed
----
5501	89250000	164193327

query II
SELECT i, x FROM keyed WHERE i = 15001
----
15001	30002

statement error
INSERT INTO keyed VALUES (15003, 3)
----
Duplicate key

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM merged
----
300001	168500500000	322333866647

query III
SELECT COUNT(*), SUM(i), SUM(x) FROM keyed
----
5501	89250000	164193327
