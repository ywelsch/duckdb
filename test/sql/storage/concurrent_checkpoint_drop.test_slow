# name: test/sql/storage/concurrent_checkpoint_drop.test_slow
# description: Dropping a table does not keep checkpoints from running; its commit waits for a running checkpoint
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE a (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO a SELECT i, 'a' || i FROM range(100000) t(i);

statement ok
CREATE INDEX a_s ON a(s)

statement ok
CREATE TABLE keep AS SELECT i FROM range(1000) t(i);

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the drop
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM a
----
100000

onlyif threadid=1
statement ok
BEGIN TRANSACTION

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 1000 millisecond

# the drop runs while the checkpoint waits before its catalog scan, its commit waits for the checkpoint
onlyif threadid=1
statement ok
DROP TABLE a

# the checkpoint has not finished when the drop statement returns
onlyif threadid=1
query I
SELECT COUNT(*) FROM mem.timing WHERE who = 'checkpoint end'
----
0

onlyif threadid=1
statement ok
COMMIT

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('commit end', now())

# a checkpoint while the reader still sees the dropped table and its indexes
onlyif threadid=1
statement ok
INSERT INTO keep VALUES (-2)

onlyif threadid=1
statement ok
CHECKPOINT

sleep 4000 millisecond

onlyif threadid=2
query II
SELECT COUNT(*), SUM(i) FROM a WHERE s LIKE 'a%'
----
100000	4999950000

onlyif threadid=2
query II
SELECT i, s FROM a WHERE i = 4242
----
4242	a4242

onlyif threadid=2
query II
SELECT i, s FROM a WHERE s = 'a777'
----
777	a777

onlyif threadid=2
statement ok
COMMIT

endloop

query I
SELECT (SELECT t FROM mem.timing WHERE who = 'commit end') >= (SELECT t FROM mem.timing WHERE who = 'checkpoint end')
----
true

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'a'
----
0

query II
SELECT COUNT(*), SUM(i) FROM keep
----
1002	499497

# a checkpoint of an empty WAL does nothing
statement ok
CREATE TABLE tick1 AS SELECT 1 AS x

statement ok
CHECKPOINT

# a reader whose snapshot is older than a drop reads the dropped table after checkpoints reused its storage
statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE d AS SELECT i, repeat(md5(i::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM d WHERE i % 3 = 0

statement ok
CREATE TABLE c AS SELECT 1 AS x

statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
SET force_compression='uncompressed'

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM c
----
1

statement ok
DROP TABLE d

statement ok
CHECKPOINT

loop k 0 3

statement ok
CREATE TABLE b{k} AS SELECT i, repeat(md5((i + 7)::VARCHAR), 160) AS s FROM range(20000) t(i);

statement ok
DELETE FROM b{k} WHERE i % 3 = 1

statement ok
CHECKPOINT

endloop

query IIIIII con1
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (WHERE i % 3 = 0), COUNT(*) FILTER (WHERE i % 3 = 1), SUM(length(s)), bool_and(s = repeat(md5(i::VARCHAR), 160)) FROM d
----
13333	133326667	0	6667	68264960	true

# a crash while the old reader still keeps the dropped blocks from reuse: they are free on disk
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick2 AS SELECT 1 AS x

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name = 'd'
----
0

query II
SELECT COUNT(*), SUM(i) FROM b2
----
13333	133320000

# a checkpoint after dropping an indexed table, while an older reader still uses its indexes, frees the index blocks
statement ok
CREATE TABLE ia (i INTEGER PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO ia SELECT i, 'a' || i FROM range(100000) t(i);

statement ok
CREATE INDEX ia_s ON ia(s)

statement ok
CHECKPOINT

statement ok con2
BEGIN TRANSACTION

query I con2
SELECT COUNT(*) FROM ia
----
100000

statement ok
DROP TABLE ia

statement ok
CREATE TABLE tick3 AS SELECT 1 AS x

statement ok
CHECKPOINT

query II con2
SELECT i, s FROM ia WHERE i = 4242
----
4242	a4242

query II con2
SELECT i, s FROM ia WHERE s = 'a777'
----
777	a777

statement ok con2
COMMIT

restart

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick4 AS SELECT 1 AS x

statement ok
CHECKPOINT
