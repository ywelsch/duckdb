# name: test/sql/storage/pragma_storage_info_include_segment_info.test
# description: Test the include_segment_info named parameter of pragma_storage_info
# group: [storage]

# smaller block sizes spill bitpacking into another compressor; pin to keep the asserted segment_info
require block_size 262144

# the asserted segment_info breakdown counts per-vector modes; pin to keep the counts stable
require vector_size 2048

load __TEST_DIR__/test_pragma_storage_info_include_segment_info.db

statement ok
PRAGMA force_compression = 'bitpacking'

statement ok
CREATE TABLE bp_tbl (a INTEGER)

statement ok
INSERT INTO bp_tbl SELECT 1 FROM range(0, 10000) tbl(i)

statement ok
INSERT INTO bp_tbl SELECT 2 FROM range(0, 10000) tbl(i)

statement ok
CHECKPOINT

# Default behavior is unchanged: segment_info is included.
query T
SELECT segment_info FROM pragma_storage_info('bp_tbl') WHERE segment_type NOT IN ('VALIDITY')
----
CONSTANT: 9, DELTA_FOR: 1

# Explicit include_segment_info=true also includes the column.
query T
SELECT segment_info FROM pragma_storage_info('bp_tbl', include_segment_info=true) WHERE segment_type NOT IN ('VALIDITY')
----
CONSTANT: 9, DELTA_FOR: 1

# Explicit include_segment_info=false omits the column.
statement error
SELECT segment_info FROM pragma_storage_info('bp_tbl', include_segment_info=false) LIMIT 1
----
<REGEX>:Binder Error:.*segment_info.*

# Row counts are unchanged when segment_info is omitted.
query I
SELECT COUNT(*) = (SELECT COUNT(*) FROM pragma_storage_info('bp_tbl', include_segment_info=false))
FROM pragma_storage_info('bp_tbl')
----
true
