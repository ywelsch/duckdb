# name: test/sql/storage/vacuum_checkpoint_concurrent_delete_timeout.test_slow
# description: A checkpoint does not merge row groups while a long delete statement is running
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_concurrent_delete_timeout.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

# five row groups
statement ok
INSERT INTO test SELECT i, 'base' FROM range(614400) t(i);

statement ok
CHECKPOINT

# every row group keeps a tenth of its rows
statement ok
DELETE FROM test WHERE i % 10 <> 0

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for four seconds after it became active, before it writes any table
statement ok
SET debug_checkpoint_sleep_ms=4000

concurrentloop threadid 0 3

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 3000 millisecond

# one second before the checkpoint merges row groups: a delete statement that runs for four seconds
onlyif threadid=1
statement ok
DELETE FROM test WHERE i = 20 AND (SELECT count(x) FROM (SELECT sleep_ms(4000) AS x)) = 0

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('long delete', now())

sleep 1250 millisecond

# while the checkpoint waits for the long delete, or right after it gave up
onlyif threadid=2
statement ok
DELETE FROM test WHERE i = 300000

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('short delete', now())

endloop

# the checkpoint finished while the long delete was running
query I
SELECT COUNT(*) FROM mem.timing d, mem.timing s, mem.timing e WHERE d.who = 'long delete' AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND e.t > s.t + INTERVAL 4 SECOND AND e.t < d.t - INTERVAL 1 SECOND
----
1

# and so did the short delete
query I
SELECT COUNT(*) FROM mem.timing d, mem.timing w WHERE d.who = 'long delete' AND w.who = 'short delete' AND w.t < d.t - INTERVAL 1 SECOND
----
1

statement ok
SET debug_checkpoint_sleep_ms=0

# no row group was merged: every row has the row id it was inserted with
query III
SELECT COUNT(*), COUNT(*) FILTER (WHERE rowid <> i), COUNT(*) FILTER (WHERE i IN (20, 300000)) FROM test
----
61438	0	0

restart

query III
SELECT COUNT(*), COUNT(*) FILTER (WHERE rowid <> i), COUNT(*) FILTER (WHERE i IN (20, 300000)) FROM test
----
61438	0	0

# the next checkpoint merges them
statement ok
DELETE FROM test WHERE i = 40

statement ok
CHECKPOINT

query IIII
SELECT COUNT(*), SUM(i), min(rowid), max(rowid) FROM test
----
61437	18873760740	0	61436

restart

query IIII
SELECT COUNT(*), SUM(i), min(rowid), max(rowid) FROM test
----
61437	18873760740	0	61436
