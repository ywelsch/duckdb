# name: test/sql/storage/vacuum_checkpoint_concurrent_late_materialization.test_slow
# description: Top-N queries that fetch their rows by row id in a second scan while checkpoints merge row groups
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_concurrent_late_materialization.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT, k BIGINT, s VARCHAR);

statement ok
INSERT INTO test SELECT i, (i * 611953) % 1044480, 'base' FROM range(1044480) t(i);

statement ok
CHECKPOINT

# the query reads the row ids of the first ten rows in one scan and fetches the rows in a second one
query II
EXPLAIN SELECT i, k, s FROM test WHERE i % 20 = 0 ORDER BY k LIMIT 10
----
physical_plan	<REGEX>:.*SEMI.*rowid.*

# thread 0 checkpoints, thread 1 thins out the table one range at a time, threads 2 and 3 run the query
concurrentloop threadid 0 4

loop x 0 40

onlyif threadid=1
statement ok
SELECT sleep_ms(20 + (random() * 40)::BIGINT)

# the rows the query returns are never deleted
onlyif threadid=1
statement ok
DELETE FROM test WHERE i >= {x} * 26112 AND i < ({x} + 1) * 26112 AND i % 20 <> 0

loop y 0 4

onlyif threadid=0
statement ok
SELECT sleep_ms(50)

onlyif threadid=0
statement ok
CHECKPOINT

endloop

loop z 0 6

onlyif threadid>1
query III
SELECT i, k, s FROM test WHERE i % 20 = 0 ORDER BY k LIMIT 10
----
0	0	base
893780	20	base
743080	40	base
592380	60	base
441680	80	base
290980	100	base
140280	120	base
1034060	140	base
883360	160	base
732660	180	base

endloop

endloop

endloop

query I
SELECT COUNT(*) FROM test
----
52224

# the checkpoints merged row groups while the queries ran
query I
SELECT COUNT(DISTINCT row_group_id) < 9 FROM pragma_storage_info('test')
----
true
