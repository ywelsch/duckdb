# name: test/sql/storage/vacuum_checkpoint_concurrent_delete_in_memory.test_slow
# description: Deletes and index scans run while an in-memory checkpoint merges row groups
# group: [storage]

# on a database file the commits of the two deletes wait for the checkpoint, see vacuum_checkpoint_concurrent_delete_index
require noforcestorage

# only the explicit checkpoints below checkpoint (some test configurations checkpoint at every commit otherwise)
statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER PRIMARY KEY, j INTEGER, s VARCHAR);

# five row groups
statement ok
INSERT INTO test SELECT i, i % 1000, 'base' FROM range(614400) t(i);

statement ok
CREATE INDEX idx_j ON test (j);

statement ok
CHECKPOINT

# every row group keeps a tenth of its rows
statement ok
DELETE FROM test WHERE i % 10 <> 0

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint pauses for six seconds after it merged the row groups
statement ok
SET debug_checkpoint_scan_sleep_ms=6000

concurrentloop threadid 0 4

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 3000 millisecond

# during the pause: index scans find the rows where the merge put them
onlyif threadid=1
query III
SELECT rowid, i, j FROM test WHERE i = 300010
----
30001	300010	10

onlyif threadid=1
query III
SELECT COUNT(*), SUM(i), SUM(rowid) FROM test WHERE j = 990
----
614	188798860	18879886

onlyif threadid=1
query III
SELECT COUNT(*), SUM(i), SUM(rowid) FROM test WHERE abs(j) = 990
----
614	188798860	18879886

# a delete in the merged row group, an insert and a duplicate of a row that moved
onlyif threadid=1
statement ok
DELETE FROM test WHERE i = 300000

onlyif threadid=1
statement ok
INSERT INTO test VALUES (-1, 1, 'during')

onlyif threadid=1
statement error
INSERT INTO test VALUES (300010, 10, 'duplicate')
----
<REGEX>:.*Constraint Error.*

# a delete that is rolled back
onlyif threadid=2
statement ok
BEGIN

onlyif threadid=2
statement ok
DELETE FROM test WHERE i = 400000

onlyif threadid=2
statement ok
ROLLBACK

# a delete that finds its rows through the other index
onlyif threadid=3
statement ok
DELETE FROM test WHERE j = 500

onlyif threadid>0
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

endloop

# the three finished during the pause
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s, mem.timing e WHERE w.who = 'writer' AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND w.t > s.t AND w.t < e.t - INTERVAL 2 SECOND
----
3

statement ok
SET debug_checkpoint_scan_sleep_ms=0

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
60826	18685262799	true

# the five row groups were merged into one
query III
SELECT min(rowid), max(rowid), COUNT(*) FROM test WHERE s = 'base'
----
0	61439	60825

# both indexes agree with the table
query III
SELECT rowid, i, j FROM test WHERE i = 400000
----
40000	400000	0

query II
SELECT COUNT(*), SUM(i) FROM test WHERE j = 0
----
614	188505000

query II
SELECT COUNT(*), SUM(i) FROM test WHERE abs(j) = 0
----
614	188505000

query II
SELECT COUNT(*) FILTER (WHERE j = 500), COUNT(*) FILTER (WHERE i = 300000) FROM test
----
0	0

query I
SELECT COUNT(*) FROM test WHERE j = 500 OR i = 300000
----
0

# the keys of deleted rows are free again, the others are not
statement ok
INSERT INTO test VALUES (300000, 0, 'again'), (500, 500, 'again')

statement error
INSERT INTO test VALUES (-1, 1, 'duplicate')
----
<REGEX>:.*Constraint Error.*

statement ok
CHECKPOINT

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
60828	18685563299	true

query II
SELECT COUNT(*), SUM(i) FROM test WHERE j = 0
----
615	188805000

query II
SELECT COUNT(*), SUM(i) FROM test WHERE abs(j) = 0
----
615	188805000

query II
SELECT i, s FROM test WHERE i = 500 OR i = 300000 OR i = 300010 ORDER BY i
----
500	again
300000	again
300010	base

statement error
INSERT INTO test VALUES (300010, 10, 'duplicate')
----
<REGEX>:.*Constraint Error.*
