# name: test/sql/storage/concurrent_checkpoint_create_table_indexes.test_slow
# description: Tables with primary keys, unique and foreign keys created while a checkpoint runs keep complete indexes
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_create_table_indexes.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE keep (i INTEGER);

statement ok
INSERT INTO keep SELECT i FROM range(1000) t(i);

statement ok
CREATE TABLE parent (id INTEGER PRIMARY KEY);

statement ok
INSERT INTO parent SELECT i FROM range(100) t(i);

statement ok
CHECKPOINT

# the checkpoint sleeps for three seconds before it scans the catalog
statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM keep
----
1000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-1)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# created and filled after the checkpoint's bound: the checkpoint does not write these tables or their indexes
onlyif threadid=1
statement ok
CREATE TABLE pk (i INTEGER PRIMARY KEY, s VARCHAR)

onlyif threadid=1
statement ok
INSERT INTO pk SELECT i, 'p' || i FROM range(1000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE uq (i INTEGER UNIQUE)

onlyif threadid=1
statement ok
INSERT INTO uq SELECT i FROM range(1000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE fk (i INTEGER REFERENCES parent(id))

onlyif threadid=1
statement ok
INSERT INTO fk SELECT i FROM range(100) t(i)

# the creates did not wait for the running checkpoint
onlyif threadid=1
statement error
CHECKPOINT
----
Cannot CHECKPOINT

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

# the next checkpoint writes the new tables with their indexes
statement ok
INSERT INTO keep VALUES (-2)

statement ok
CHECKPOINT

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM pk
----
1000	1000

query II
SELECT i, s FROM pk WHERE i = 777
----
777	p777

query II
EXPLAIN ANALYZE SELECT i, s FROM pk WHERE i = 777
----
analyzed_plan	<REGEX>:.*Index Scan.*

statement error
INSERT INTO pk VALUES (5, 'duplicate')
----
violates primary key constraint

statement error
INSERT INTO uq VALUES (5)
----
violates unique constraint

statement error
DELETE FROM parent WHERE id = 5
----
still referenced by a foreign key

# a table with a primary key created while a checkpoint runs, and replayed from the WAL
statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM keep
----
1002

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-3)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

onlyif threadid=1
statement ok
CREATE TABLE a_replayed (i INTEGER PRIMARY KEY)

onlyif threadid=1
statement ok
INSERT INTO a_replayed SELECT i FROM range(1000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE fk_replayed (i INTEGER REFERENCES parent(id))

onlyif threadid=1
statement ok
INSERT INTO fk_replayed SELECT i FROM range(50) t(i)

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement error
INSERT INTO a_replayed VALUES (5)
----
violates primary key constraint

statement error
INSERT INTO fk_replayed VALUES (500)
----
foreign key constraint

statement error
DELETE FROM parent WHERE id = 7
----
still referenced by a foreign key

# rows inserted after the checkpoint copied the replayed table's index, before it installs the copy: they go to
# the deltas. Each table write sleeps a second, the checkpoint writes the tables by name, a_replayed first.
statement ok
SET debug_checkpoint_scan_sleep_ms=1000

concurrentloop threadid 0 3

onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM keep
----
1003

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-4)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 3000 millisecond

onlyif threadid=1
statement ok
INSERT INTO a_replayed SELECT i FROM range(1000, 2000) t(i)

# the insert did not wait for the running checkpoint
onlyif threadid=1
statement error
CHECKPOINT
----
Cannot CHECKPOINT

sleep 6000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_scan_sleep_ms=0

statement ok
INSERT INTO keep VALUES (-5)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM a_replayed
----
2000	2000

query I
SELECT i FROM a_replayed WHERE i = 1500
----
1500

statement error
INSERT INTO a_replayed VALUES (1500)
----
violates primary key constraint

statement error
INSERT INTO pk VALUES (5, 'duplicate')
----
violates primary key constraint

statement error
DELETE FROM parent WHERE id = 7
----
still referenced by a foreign key

statement ok
INSERT INTO keep VALUES (-6)

statement ok
CHECKPOINT
