# name: test/sql/storage/vacuum_checkpoint_concurrent_delete_abort.test_slow
# description: Deletes run while a checkpoint merges row groups and then fails, and recover
# group: [storage]

# db is an attached database, so a failing checkpoint on it is scoped to db (the instance keeps running)

foreach abort_mode before_header before_header_non_fatal before_wal_finish

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '{TEST_DIR}/vacuum_checkpoint_concurrent_delete_abort_{abort_mode}.db' AS db (STORAGE_VERSION 'v2.1.0')

statement ok
CREATE TABLE db.test (i INTEGER PRIMARY KEY, s VARCHAR);

# five row groups
statement ok
INSERT INTO db.test SELECT i, 'base' FROM range(614400) t(i);

statement ok
CHECKPOINT db

# every row group keeps a tenth of its rows
statement ok
DELETE FROM db.test WHERE i % 10 <> 0

# the checkpoint sleeps for four seconds after it became active, again for four seconds after it merged the row
# groups, and then fails
statement ok
SET debug_checkpoint_sleep_ms=4000

statement ok
SET debug_checkpoint_scan_sleep_ms=4000

statement ok
SET debug_checkpoint_abort='{abort_mode}'

concurrentloop threadid 0 4

sleep 1000 millisecond

onlyif threadid=0
statement error
CHECKPOINT db
----
<REGEX>:.*Checkpoint aborted.*

sleep 2000 millisecond

# during the first sleep: a delete in the first row group, which the checkpoint then keeps as it is
onlyif threadid=1
statement ok
DELETE FROM db.test WHERE i = 0

sleep 4000 millisecond

# during the second sleep: the last four row groups are merged, the header is not written yet
onlyif threadid=2
statement ok
DELETE FROM db.test WHERE i = 10

onlyif threadid=2
statement ok
INSERT INTO db.test VALUES (-1, 'during')

# a delete in the merged row group does not commit if the checkpoint fails before it wrote the header
onlyif threadid=3&&abort_mode<>before_wal_finish
statement error
DELETE FROM db.test WHERE i = 300000
----
<REGEX>:.*(Cannot commit|invalidated).*

# with the header written it commits, unless the failure of the checkpoint gets there first
onlyif threadid=3&&abort_mode=before_wal_finish
statement maybe
DELETE FROM db.test WHERE i = 300000
----
<REGEX>:.*invalidated.*

endloop

statement ok
SET debug_checkpoint_abort='none'

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
SET debug_checkpoint_scan_sleep_ms=0

restart

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
ATTACH '{TEST_DIR}/vacuum_checkpoint_concurrent_delete_abort_{abort_mode}.db' AS db

# everything that committed is there
query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM db.test WHERE i <> 300000
----
61438	18873760789	true

query I
SELECT COUNT(*) FROM db.test WHERE i = 0 OR i = 10
----
0

query II
SELECT rowid, s FROM db.test WHERE i = -1
----
614400	during

# a checkpoint that failed before its header: the rows are where they were, and the last delete did not commit
skipif abort_mode=before_wal_finish
query II
SELECT COUNT(*) FILTER (WHERE rowid <> i), COUNT(*) FILTER (WHERE i = 300000) FROM db.test
----
1	1

# a checkpoint that failed after its header: the last four row groups are merged
onlyif abort_mode=before_wal_finish
query II
SELECT rowid, i FROM db.test WHERE abs(i) IN (20, 122880, 300010, 614390) ORDER BY i
----
20	20
122880	122880
140593	300010
172031	614390

# the index agrees with the table
query I
SELECT rowid = (SELECT rowid FROM db.test WHERE abs(i) = 300010) FROM db.test WHERE i = 300010
----
true

statement error
INSERT INTO db.test VALUES (300010, 'duplicate')
----
<REGEX>:.*Constraint Error.*

statement ok
INSERT INTO db.test VALUES (0, 'again')

statement ok
CHECKPOINT db

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/vacuum_checkpoint_concurrent_delete_abort_{abort_mode}.db' AS db

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM db.test WHERE i <> 300000
----
61439	18873760789	true

query II
SELECT i, s FROM db.test WHERE i = 0 OR i = 10 OR i = 300010 ORDER BY i
----
0	again
300010	base

statement error
INSERT INTO db.test VALUES (300010, 'duplicate')
----
<REGEX>:.*Constraint Error.*

statement ok
DETACH db

restart

endloop
