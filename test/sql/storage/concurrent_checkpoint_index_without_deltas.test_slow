# name: test/sql/storage/concurrent_checkpoint_index_without_deltas.test_slow
# description: Commits that change an index without checkpoint deltas wait for a running checkpoint
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_index_without_deltas.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# the indexes behave like index types that write changes made during a checkpoint straight to the index
statement ok
SET debug_disable_index_checkpoint_deltas=true

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, v VARCHAR);

statement ok
CREATE TABLE n (id INTEGER, v VARCHAR);

statement ok
CREATE INDEX n_id ON n(id)

statement ok
INSERT INTO t SELECT i, 'v' || i FROM range(1000) t(i);

statement ok
INSERT INTO n SELECT i, 'v' || i FROM range(1000) t(i);

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint pauses after it wrote the row groups of a table, before it installs them and writes its indexes
statement ok
SET debug_checkpoint_scan_sleep_ms=2000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
1000

sleep 300 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, 'pre')

onlyif threadid=0
statement ok
INSERT INTO n VALUES (-1, 'pre')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 700 millisecond

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('first commit start', now())

onlyif threadid=1
statement ok
INSERT INTO t VALUES (5000, 'during')

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('first commit end', now())

onlyif threadid=1
statement ok
DELETE FROM t WHERE id = 7

onlyif threadid=1
statement ok
INSERT INTO n VALUES (5000, 'during')

onlyif threadid=1
statement ok
DELETE FROM n WHERE id = 7

sleep 5000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

# the first commit waited for the checkpoint, which pauses for two seconds per table
query I
SELECT (SELECT t FROM mem.timing WHERE who = 'first commit end') - (SELECT t FROM mem.timing WHERE who = 'first commit start') > INTERVAL 1 SECOND
----
true

statement ok
SET debug_checkpoint_scan_sleep_ms=0

loop k 0 2

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM t
----
1001	1001

query I
SELECT COUNT(*) FROM t WHERE id = 5000
----
1

query I
SELECT COUNT(*) FROM t WHERE id = 7
----
0

query I
SELECT COUNT(*) FROM n WHERE id = 5000
----
1

query I
SELECT COUNT(*) FROM n WHERE id = 7
----
0

statement error
INSERT INTO t VALUES (5000, 'dup')
----
violates primary key constraint

# replay the WAL as after a crash
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_disable_index_checkpoint_deltas=true

endloop

statement ok
INSERT INTO t VALUES (7, 'again')

statement ok
CHECKPOINT
