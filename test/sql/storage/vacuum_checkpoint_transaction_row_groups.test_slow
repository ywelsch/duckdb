# name: test/sql/storage/vacuum_checkpoint_transaction_row_groups.test_slow
# description: A transaction that has asked for row ids of a table keeps checkpoints from moving them until it ends
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_transaction_row_groups.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE other (i BIGINT);

# five row groups each, of which the last three keep a tenth of their rows
foreach tbl t_ids t_del t_plain

statement ok
CREATE TABLE {tbl} (i BIGINT, s VARCHAR);

statement ok
INSERT INTO {tbl} SELECT i, 'base' FROM range(614400) t(i);

endloop

statement ok
CHECKPOINT

statement ok
DELETE FROM t_ids WHERE i >= 245760 AND i % 10 <> 0

# a transaction that has asked for row ids: the checkpoint leaves the row groups of that table as they are
statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM t_ids WHERE i = 300000
----
300000	300000

statement ok con2
CHECKPOINT

query I con2
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_ids')
----
5

query II con1
SELECT rowid, i FROM t_ids WHERE i = 300000
----
300000	300000

statement ok con1
COMMIT

statement ok
DELETE FROM t_del WHERE i >= 245760 AND i % 10 <> 0

# a transaction that has deleted rows keeps the row group it deleted in, the others are merged
statement ok con1
BEGIN

statement ok con1
DELETE FROM t_del WHERE i = 300000

statement ok con2
INSERT INTO other VALUES (1)

statement ok con2
CHECKPOINT

query II con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_del')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_ids'))
----
4	3

query II con1
SELECT rowid, i FROM t_del WHERE i = 300010
----
300010	300010

statement ok con1
COMMIT

# a transaction that has read a table without asking for row ids does not hold the merges back: a query that
# fetches rows by row id on its own account does not count
statement ok con2
DELETE FROM t_plain WHERE i >= 245760 AND i % 10 <> 0

statement ok con1
BEGIN

query IT con1
SELECT SUM(i), MIN(s) FROM t_plain
----
46053150720	base

query II con1
EXPLAIN SELECT i, s FROM t_plain WHERE i % 20 = 0 ORDER BY i DESC LIMIT 3
----
physical_plan	<REGEX>:.*SEMI.*rowid.*

query IT con1
SELECT i, s FROM t_plain WHERE i % 20 = 0 ORDER BY i DESC LIMIT 3
----
614380	base
614360	base
614340	base

query I con1
SELECT COUNT(*) FROM t_plain
----
282624

statement ok con2
CHECKPOINT

query III con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_plain')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_del')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_ids'))
----
3	3	3

# it deletes, updates and reads the rows where they are now
statement ok con1
DELETE FROM t_plain WHERE i = 300010

statement ok con1
UPDATE t_plain SET s = 'changed' WHERE i = 300020

query IIT con1
SELECT rowid, i, s FROM t_plain WHERE i IN (300000, 300010, 300020) ORDER BY i
----
251184	300000	base
251186	300020	changed

statement ok con1
COMMIT

# from its first look at the row ids on, they stay as they are
statement ok
DELETE FROM t_ids WHERE i < 245760 AND i % 10 <> 0

statement ok con1
BEGIN

query I con1
SELECT SUM(i) FROM t_ids
----
18874060800

query II con1
SELECT rowid, i FROM t_ids WHERE i = 300000
----
251184	300000

statement ok con2
CHECKPOINT

query I con2
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_ids')
----
3

query II con1
SELECT rowid, i FROM t_ids WHERE i = 300000
----
251184	300000

statement ok con1
COMMIT

statement ok con2
INSERT INTO other VALUES (3)

statement ok con2
CHECKPOINT

query III con2
SELECT rowid, i, (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t_ids')) FROM t_ids WHERE i = 300000
----
30000	300000	1

# a checkpoint that rewrites a row group without moving rows: the transaction sees its own update afterwards
statement ok con2
UPDATE t_plain SET s = 'theirs' WHERE i = 100

statement ok con1
BEGIN

query IT con1
SELECT rowid, s FROM t_plain WHERE i = 200
----
200	base

statement ok con2
CHECKPOINT

statement ok con1
UPDATE t_plain SET s = 'mine' WHERE i = 200

query IIT con1
SELECT rowid, i, s FROM t_plain WHERE i IN (100, 200) ORDER BY i
----
100	100	theirs
200	200	mine

statement ok con1
COMMIT

restart

query III
SELECT (SELECT COUNT(*) FROM t_ids), (SELECT COUNT(*) FROM t_del), (SELECT COUNT(*) FROM t_plain)
----
61440	282623	282623

query IIT
SELECT rowid, i, s FROM t_plain WHERE i IN (100, 200, 300000, 300010, 300020) ORDER BY i
----
100	100	theirs
200	200	mine
251184	300000	base
251186	300020	changed

query II
SELECT (SELECT rowid FROM t_ids WHERE i = 300000), (SELECT rowid FROM t_del WHERE i = 300010)
----
30000	251184
