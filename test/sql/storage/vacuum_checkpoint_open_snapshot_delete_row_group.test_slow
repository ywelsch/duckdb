# name: test/sql/storage/vacuum_checkpoint_open_snapshot_delete_row_group.test_slow
# description: A row group emptied by a delete that an open snapshot does not see is kept until the snapshot is gone
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_delete_row_group.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

# nine row groups
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

statement ok
DELETE FROM test WHERE i % 10 <> 0

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

# the third row group loses its remaining rows after the snapshot started
statement ok
DELETE FROM test WHERE i >= 245760 AND i < 368640

statement ok
CHECKPOINT

# two row groups merged, the third kept, six merged
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
3

query III con2
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104448	54546401280	true

query I con2
SELECT COUNT(*) FROM test WHERE i >= 245760 AND i < 368640
----
12288

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
92160	50771589120	true

statement ok con2
COMMIT

# the next checkpoint drops the row group that was kept
statement ok
DELETE FROM test WHERE i = 500000

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
92159	50771089120	true

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
92159	50771089120	true
