# name: test/sql/storage/alter_concurrent_checkpoint_reuse.test
# description: Row groups a checkpoint merged while an ALTER was open are written unchanged once the ALTER commits
# group: [storage]

require skip_reload

load {TEST_DIR}/alter_concurrent_checkpoint_reuse.db

statement ok
ATTACH '{TEST_DIR}/alter_concurrent_checkpoint_reuse_r.db' AS r (ROW_GROUP_SIZE 2048)

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE r.t AS SELECT i, repeat(md5(i::VARCHAR), 160) AS s FROM range(8192) t(i)

statement ok
CREATE TABLE r.filler (i INTEGER, s VARCHAR)

statement ok
CREATE TABLE r.tick (i INTEGER)

statement ok
CHECKPOINT r

# the deletes go to disk without a merge: a reader from before them is open
statement ok con2
BEGIN

query I con2
SELECT COUNT(*) FROM r.filler
----
0

statement ok
DELETE FROM r.t WHERE i < 6144 AND i % 10 <> 0

statement ok
CHECKPOINT r

statement ok con2
COMMIT

restart

statement ok
ATTACH '{TEST_DIR}/alter_concurrent_checkpoint_reuse_r.db' AS r (ROW_GROUP_SIZE 2048)

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET force_compression='uncompressed'

statement ok
SET debug_verify_blocks=true

# the WAL has to hold something, or the checkpoint does nothing
statement ok
INSERT INTO r.tick VALUES (1)

# nothing commits after the ALTER starts: the checkpoint merges the row groups with deletes
statement ok con1
BEGIN

statement ok con1
ALTER TABLE r.t ADD COLUMN k INTEGER DEFAULT 1

statement ok
CHECKPOINT r

# a reader from before the commit: the next checkpoint does not merge, it writes the copied row groups as they are
statement ok con3
BEGIN

query I con3
SELECT COUNT(*) FROM r.filler
----
0

statement ok con1
COMMIT

statement ok
CHECKPOINT r

statement ok con3
COMMIT

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = repeat(md5(i::VARCHAR), 160)), SUM(k) FROM r.t
----
2663	16567090	2663	2663

restart

statement ok
ATTACH '{TEST_DIR}/alter_concurrent_checkpoint_reuse_r.db' AS r (ROW_GROUP_SIZE 2048)

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET force_compression='uncompressed'

statement ok
SET debug_verify_blocks=true

# takes the blocks that the header lists as free
statement ok
INSERT INTO r.filler SELECT i, repeat(md5((i + 7)::VARCHAR), 160) FROM range(8192) t(i)

statement ok
CHECKPOINT r

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = repeat(md5(i::VARCHAR), 160)), SUM(k) FROM r.t
----
2663	16567090	2663	2663

query II
SELECT COUNT(*), COUNT(*) FILTER (s = repeat(md5((i + 7)::VARCHAR), 160)) FROM r.filler
----
8192	8192
