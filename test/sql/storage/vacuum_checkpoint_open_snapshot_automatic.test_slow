# name: test/sql/storage/vacuum_checkpoint_open_snapshot_automatic.test_slow
# description: An automatic checkpoint vacuums while a snapshot older than the last commit is open
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_automatic.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

statement ok
CREATE TABLE other (i BIGINT);

statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

statement ok
DELETE FROM test WHERE i % 10 <> 0

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

statement ok
SET checkpoint_threshold='10KB'

# the commit checkpoints: the WAL holds the delete
statement ok
INSERT INTO other VALUES (42)

statement ok
SET checkpoint_threshold='1TB'

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

query I con2
SELECT COUNT(*) FROM other
----
0

statement ok con2
COMMIT

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104448	54546401280	true

query I
SELECT i FROM other
----
42
