# name: test/sql/storage/checkpoint/sparse_update_no_autocheckpoint.test
# description: The automatic checkpoint decision estimates updates by the tuples written to the WAL, not by the vector-sized undo allocations
# group: [checkpoint]

load {TEST_DIR}/sparse_update_no_autocheckpoint.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t AS SELECT i AS id, i::BIGINT AS a, i::BIGINT AS b FROM range(200000) t(i)

statement ok
CHECKPOINT

query I
SELECT wal_size == '0 bytes' FROM pragma_database_size();
----
1

statement ok
SET checkpoint_threshold = '500 KB'

# update a single tuple in each of the ~98 vectors of the table, on two BIGINT columns
# the undo buffer allocates ~24 KB per (column, vector) for this (~4.8 MB in total),
# but only ~98 * 2 * 16 bytes end up in the WAL - this must not trigger an automatic checkpoint
statement ok
UPDATE t SET a = a + 1, b = b + 1 WHERE rowid % 2048 = 0

query I
SELECT wal_size != '0 bytes' FROM pragma_database_size();
----
1

query II
SELECT COUNT(*), SUM(a - id) FROM t WHERE rowid % 2048 = 0
----
98	98

# a dense update that writes more than the threshold to the WAL still triggers the automatic checkpoint
# 100000 tuples * 2 columns * (8 + 8) bytes = ~3.2 MB > 500 KB
statement ok
UPDATE t SET a = a + 1, b = b + 1 WHERE rowid < 100000

query I
SELECT wal_size == '0 bytes' FROM pragma_database_size();
----
1

query III
SELECT COUNT(*), SUM(a - id), SUM(b - id) FROM t
----
200000	100098	100098
