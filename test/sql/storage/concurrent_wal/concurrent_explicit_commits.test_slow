# name: test/sql/storage/concurrent_wal/concurrent_explicit_commits.test_slow
# description: Explicit COMMITs park while another commit's WAL sync runs, next to checkpoints that drain them
# group: [concurrent_wal]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# widen the sync window so that commits park behind it
statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/concurrent_explicit_commits.db' AS db

statement ok
CREATE TABLE db.integers(i INTEGER)

# threads 0-8 commit explicit transactions; thread 9 checkpoints
concurrentloop threadid 0 10

loop x 0 50

onlyif threadid<>9
statement ok
BEGIN

onlyif threadid<>9
statement ok
INSERT INTO db.integers VALUES ({threadid} * 1000 + {x})

onlyif threadid<>9
statement ok
COMMIT

endloop

loop x 0 20

onlyif threadid=9
statement maybe
CHECKPOINT db
----

endloop

endloop

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM db.integers
----
450	450

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_explicit_commits.db' AS db

query I
SELECT COUNT(*) FROM db.integers
----
450
