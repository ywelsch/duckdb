# name: test/sql/storage/concurrent_wal/concurrent_deferred_commits.test_slow
# description: Commits that defer their WAL sync, next to threads that sync and checkpoint
# group: [concurrent_wal]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_wal_fsync_sleep_ms=2

statement ok
ATTACH '{TEST_DIR}/concurrent_deferred_commits.db' AS db

statement ok
CREATE TABLE db.integers(i INTEGER)

# threads 0-7 commit without syncing; thread 8 syncs; thread 9 checkpoints
concurrentloop threadid 0 10

onlyif threadid<8
statement ok
SET defer_commit_sync=true

loop x 0 50

onlyif threadid<8
statement ok
INSERT INTO db.integers VALUES ({threadid} * 1000 + {x})

onlyif threadid=8
statement ok
CALL sync_wal('db')

endloop

loop x 0 20

onlyif threadid=9
statement maybe
CHECKPOINT db
----

endloop

endloop

statement ok
CALL sync_wal('db')

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM db.integers
----
400	400

statement ok
DETACH db

statement ok
ATTACH '{TEST_DIR}/concurrent_deferred_commits.db' AS db

query I
SELECT COUNT(*) FROM db.integers
----
400
