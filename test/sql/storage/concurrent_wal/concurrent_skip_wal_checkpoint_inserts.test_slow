# name: test/sql/storage/concurrent_wal/concurrent_skip_wal_checkpoint_inserts.test_slow
# description: Commits proceed while a checkpoint-instead-of-WAL commit's checkpoint is running (ack-gated, not lock-excluded)
# group: [concurrent_wal]

statement ok
SET auto_checkpoint_skip_wal_threshold=1

statement ok
ATTACH '{TEST_DIR}/skip_wal_gate.db' AS main_db

statement ok
SET checkpoint_threshold='100KB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_checkpoint_sleep_ms=50

statement ok
CREATE TABLE main_db.big(i INTEGER)

statement ok
CREATE TABLE main_db.small(t INTEGER, i INTEGER)

concurrentloop threadid 0 8

loop x 0 20

# thread 0 repeatedly triggers checkpoint-instead-of-WAL commits (large changesets)
onlyif threadid=0
statement maybe
INSERT INTO main_db.big SELECT range FROM range({x} * 10000, ({x} + 1) * 10000);
----

# other threads commit small inserts concurrently: they ride the checkpoint WAL,
# gated behind the pending commit, and must never be lost once acknowledged
onlyif threadid>0
statement maybe
INSERT INTO main_db.small VALUES ({threadid}, {x});
----

endloop

endloop

# every row pair in small must be unique (no double-replay) and consistent
query I
SELECT count(*) = count(DISTINCT t * 1000 + i) FROM main_db.small
----
true

restart

statement ok
ATTACH '{TEST_DIR}/skip_wal_gate.db' AS main_db (READ_ONLY)

# replay must reproduce exactly the committed state
query I
SELECT count(*) = count(DISTINCT t * 1000 + i) FROM main_db.small
----
true

query I
SELECT count(*) % 10000 = 0 FROM main_db.big
----
true
