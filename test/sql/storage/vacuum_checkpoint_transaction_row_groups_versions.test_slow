# name: test/sql/storage/vacuum_checkpoint_transaction_row_groups_versions.test_slow
# description: A transaction that has asked for row ids keeps them across checkpoints, on every storage version
# group: [storage]

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

foreach version v1.0.0 v2.0.0 v2.1.0

statement ok
ATTACH '{TEST_DIR}/vacuum_checkpoint_transaction_row_groups_{version}.db' AS db (STORAGE_VERSION '{version}')

statement ok
CREATE TABLE db.other (i BIGINT);

# five row groups, of which the last three keep a tenth of their rows
statement ok
CREATE TABLE db.test (i BIGINT, s VARCHAR);

statement ok
INSERT INTO db.test SELECT i, 'base' FROM range(614400) t(i);

statement ok
CHECKPOINT db

statement ok
DELETE FROM db.test WHERE i >= 245760 AND i % 10 <> 0

# a transaction that has asked for row ids: the checkpoint leaves the row groups as they are
statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM db.test WHERE i = 300000
----
300000	300000

statement ok con2
CHECKPOINT db

query I con2
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('db.test')
----
5

query II con1
SELECT rowid, i FROM db.test WHERE i = 300000
----
300000	300000

statement ok con1
COMMIT

# a transaction that only ran a query that fetches rows by row id on its own account does not hold the merges back
statement ok con2
INSERT INTO db.other VALUES (1)

statement ok con1
BEGIN

query IT con1
SELECT i, s FROM db.test WHERE i % 20 = 0 ORDER BY i DESC LIMIT 3
----
614380	base
614360	base
614340	base

statement ok con2
CHECKPOINT db

query III con2
SELECT rowid, i, (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('db.test')) FROM db.test WHERE i = 300000
----
251184	300000	3

# it deletes and reads the rows where they are now
statement ok con1
DELETE FROM db.test WHERE i = 300010

query II con1
SELECT rowid, i FROM db.test WHERE i IN (300000, 300010, 300020) ORDER BY i
----
251184	300000
251186	300020

statement ok con1
ROLLBACK

statement ok
DETACH db

endloop
