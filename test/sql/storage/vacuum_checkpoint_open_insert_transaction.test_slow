# name: test/sql/storage/vacuum_checkpoint_open_insert_transaction.test_slow
# description: An open transaction that only inserted does not stop a checkpoint from vacuuming
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_insert_transaction.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

statement ok
INSERT INTO test SELECT i, 'base' FROM range(400000) t(i);

statement ok
CHECKPOINT

statement ok
DELETE FROM test WHERE i >= 245760 OR i % 2 = 0

statement ok con2
BEGIN TRANSACTION

statement ok con2
INSERT INTO test VALUES (-1, 'open')

statement ok
CHECKPOINT

# the checkpoint vacuumed although the insert is still open
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query II
SELECT COUNT(*), SUM(i) FROM test
----
122880	15099494400

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
122881	15099494399

statement ok con2
COMMIT

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122881	15099494399	true

statement ok
DELETE FROM test WHERE i = 3

statement ok
UPDATE test SET s = 'committed' WHERE s = 'open'

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122880	15099494396	true

query II
SELECT i, s FROM test WHERE i < 5 ORDER BY i
----
-1	committed
1	base

statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122880	15099494396	true
