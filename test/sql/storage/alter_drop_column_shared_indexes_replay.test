# name: test/sql/storage/alter_drop_column_shared_indexes_replay.test
# description: Indexes, bulk appends and WAL replay on a table version that hides a dropped column
# group: [storage]

require skip_reload

# the latest storage version remaps the index when a vacuum moves rows
load {TEST_DIR}/alter_drop_column_shared_indexes_replay.db readwrite latest

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t (a INTEGER, b VARCHAR, c INTEGER, d INTEGER)

# a bulk append writes the row groups optimistically, the dropped column's blocks among them
statement ok
INSERT INTO t SELECT i, 'b' || i, i, i % 7 FROM range(300000) t(i)

statement ok
ALTER TABLE t DROP COLUMN b

# an index on a column past the hidden one
statement ok
CREATE UNIQUE INDEX t_c ON t (c)

statement error
INSERT INTO t VALUES (1, 5, 1)
----
Duplicate key

statement error
ALTER TABLE t DROP COLUMN a
----
an index depends on a column after it

statement ok
INSERT INTO t VALUES (-1, 300000, 1)

statement ok
DELETE FROM t WHERE c % 3 = 0

statement ok
UPDATE t SET c = c + 1000000 WHERE c % 3 = 1 AND c < 1000

query II
SELECT a, c FROM t WHERE c = 1000001
----
1	1000001

statement ok
BEGIN

statement ok
INSERT INTO t SELECT i, i + 2000000, i % 7 FROM range(200000) t(i)

statement ok
DELETE FROM t WHERE c = 2000005

statement ok
COMMIT

query III
SELECT COUNT(*), SUM(a), SUM(c) FROM t
----
399999	49999899995	450330899995

statement ok
CREATE TABLE row_groups_before AS SELECT COUNT(DISTINCT row_group_id) AS c FROM pragma_storage_info('t')

statement ok
CHECKPOINT

# the vacuum merged row groups and moved rows: their index entries were remapped
query I
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('t')) < c FROM row_groups_before
----
true

query II
SELECT a, c FROM t WHERE c IN (2, 1000001, 299999, 2150000, 2199999) ORDER BY c
----
2	2
299999	299999
1	1000001
150000	2150000
199999	2199999

statement error
INSERT INTO t VALUES (8, 2150000, 1)
----
Duplicate key

restart

statement ok
SET debug_verify_blocks=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

query II
SELECT a, c FROM t WHERE c IN (2, 1000001, 299999, 2150000, 2199999) ORDER BY c
----
2	2
299999	299999
1	1000001
150000	2150000
199999	2199999

statement error
INSERT INTO t VALUES (8, 299999, 1)
----
Duplicate key

# writes after the checkpoint, replayed from the WAL, with an index created after the DROP COLUMN
statement ok
DROP INDEX t_c

statement ok
ALTER TABLE t DROP COLUMN d

statement ok
CREATE UNIQUE INDEX t_c ON t (c)

statement ok
INSERT INTO t VALUES (7, 3000000)

statement ok
UPDATE t SET c = -c WHERE c > 2199990

statement ok
DELETE FROM t WHERE c = 2000007

query III
SELECT COUNT(*), SUM(a), SUM(c) FROM t
----
399999	49999899995	450286300078

restart

statement ok
SET debug_verify_blocks=true

statement ok
PRAGMA disable_checkpoint_on_shutdown

query III
SELECT COUNT(*), SUM(a), SUM(c) FROM t
----
399999	49999899995	450286300078

statement error
INSERT INTO t VALUES (8, 1000004)
----
Duplicate key

query I
SELECT c FROM t WHERE c = 1000004
----
1000004

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(a), SUM(c) FROM t
----
399999	49999899995	450286300078

query I
SELECT column_name FROM duckdb_columns() WHERE table_name = 't' ORDER BY column_index
----
a
c
