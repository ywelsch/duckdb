# name: test/sql/storage/vacuum_checkpoint_concurrent_insert.test_slow
# description: Inserts commit while a vacuuming checkpoint shrinks the table and keep their row ids across a restart
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_concurrent_insert.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

# four row groups
statement ok
INSERT INTO test SELECT i, 'base' FROM range(400000) t(i);

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
4

# the last two row groups are deleted completely, the first two keep half of their rows
statement ok
DELETE FROM test WHERE i >= 245760 OR i % 2 = 0

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for four seconds after it became active, before it writes any table, and again for six
# seconds after it vacuumed the row groups, before it replaces them
statement ok
SET debug_checkpoint_sleep_ms=4000

statement ok
SET debug_checkpoint_scan_sleep_ms=6000

concurrentloop threadid 0 3

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 2000 millisecond

# during the first sleep: before the table is snapshotted
onlyif threadid=1
statement ok
INSERT INTO test VALUES (-1, 'first')

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('first', now())

sleep 4000 millisecond

# during the pause: after the row groups were vacuumed, before they are replaced
onlyif threadid=2
statement ok
INSERT INTO test VALUES (-2, 'second')

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('second', now())

endloop

# both inserts committed while the checkpoint was running
query I
SELECT COUNT(*) FROM mem.timing f, mem.timing s WHERE f.who = 'first' AND s.who = 'checkpoint start' AND f.t > s.t AND f.t < s.t + INTERVAL 4 SECOND
----
1

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s, mem.timing e WHERE w.who = 'second' AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND w.t > s.t + INTERVAL 4 SECOND AND w.t < e.t - INTERVAL 2 SECOND
----
1

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
SET debug_checkpoint_scan_sleep_ms=0

# the checkpoint vacuumed: the merged row group and the row group of the two inserts
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
2

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122882	15099494397	true

# the inserts keep the row ids they got behind the row groups the checkpoint dropped
query II
SELECT rowid, s FROM test WHERE i < 0 ORDER BY rowid
----
400000	first
400001	second

# changes that address the inserted rows and a vacuumed row by row id
statement ok
DELETE FROM test WHERE s = 'first'

statement ok
UPDATE test SET s = 'updated' WHERE s = 'second'

statement ok
DELETE FROM test WHERE i = 1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122880	15099494397	true

# WAL replay of the inserts, the deletes and the update
restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122880	15099494397	true

query III
SELECT rowid, i, s FROM test WHERE i < 3 ORDER BY rowid
----
400001	-2	updated

statement ok
INSERT INTO test VALUES (-3, 'third')

query II
SELECT rowid, s FROM test WHERE i < 0 ORDER BY rowid
----
400001	updated
400002	third

statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
122881	15099494394	true

query II
SELECT rowid, s FROM test WHERE i < 0 ORDER BY rowid
----
400001	updated
400002	third
