# name: test/sql/storage/concurrent_checkpoint_drop_schema.test_slow
# description: A schema dropped with its tables and indexes under an older snapshot, and one whose drop takes an index of another table
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_drop_schema.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.a (i INTEGER PRIMARY KEY, v VARCHAR)

statement ok
INSERT INTO s.a SELECT i, 'a' || i FROM range(200000) t(i)

statement ok
CREATE INDEX a_v ON s.a(v)

statement ok
CREATE TABLE s.b AS SELECT i, repeat('b', 200) || i AS v FROM range(200000) t(i)

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

statement ok con1
BEGIN TRANSACTION

query I con1
SELECT COUNT(*) FROM s.a
----
200000

statement ok
DROP SCHEMA s CASCADE

statement ok
INSERT INTO tick VALUES (1)

# frees both tables and their indexes on disk while con1 still reads them
statement ok
CHECKPOINT

query II con1
SELECT v, i FROM s.a WHERE i = 4242
----
a4242	4242

query I con1
SELECT i FROM s.a WHERE v = 'a777'
----
777

query II con1
SELECT COUNT(*), SUM(length(v)) FROM s.b
----
200000	41088890

# a crash while con1 still reads the dropped schema
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE schema_name = 's'
----
0

# an index of a table in another schema depends on a macro of the schema, and goes with it while a checkpoint runs
statement ok
CREATE SCHEMA m

statement ok
CREATE MACRO m.twice(x) AS x * 2

statement ok
CREATE TABLE t (i INTEGER, v VARCHAR)

statement ok
INSERT INTO t SELECT i, 't' || i FROM range(200000) t(i)

statement ok
CREATE INDEX t_twice ON t(m.twice(i))

statement ok
CHECKPOINT

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM t
----
200000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, 'before')

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

# the checkpoint waits before its catalog scan: its catalog has the index, and it still writes it
onlyif threadid=1
statement ok
DROP SCHEMA m CASCADE

onlyif threadid=1
query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 't_twice'
----
0

onlyif threadid=1
statement ok
INSERT INTO t VALUES (-2, 'during')

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

# replay the WAL on top of the checkpoint that ran during the drop, twice
restart

loop k 0 2

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE schema_name = 'm'
----
0

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE table_name = 't'
----
0

query II
SELECT COUNT(*), SUM(i) FROM t
----
200002	19999899997

restart

endloop

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO tick VALUES (3)

# the checkpoint accounts for every block, also those of the dropped index
statement ok
CHECKPOINT

restart

query II
SELECT COUNT(*), SUM(i) FROM t
----
200002	19999899997
