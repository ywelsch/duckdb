# name: test/sql/storage/alter_add_column_shared_paused.test_slow
# description: ADD COLUMN with a constant while a checkpoint is paused between writing the table and publishing it
# group: [storage]

require skip_reload

load {TEST_DIR}/alter_add_column_shared_paused.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

# a full checkpoint merges the row groups: the column added meanwhile is filled for the merged ones at publish
statement ok
CREATE TABLE m AS SELECT i, i::VARCHAR AS s FROM range(400000) t(i)

statement ok
CHECKPOINT

statement ok
DELETE FROM m WHERE i < 300000 AND i % 10 <> 0

statement ok
SET debug_checkpoint_scan_sleep_ms=2000

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
CHECKPOINT

sleep 700 millisecond

onlyif threadid=1
statement ok
BEGIN

onlyif threadid=1
statement ok
ALTER TABLE m ADD COLUMN k INTEGER DEFAULT 4

onlyif threadid=1
query II
SELECT COUNT(*), SUM(k) FROM m
----
130000	520000

sleep 2500 millisecond

onlyif threadid=1
query II
SELECT COUNT(*), SUM(k) FROM m
----
130000	520000

onlyif threadid=1
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_scan_sleep_ms=0

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('m')
----
2

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR), SUM(k) FROM m
----
130000	39499800000	130000	520000

statement ok
INSERT INTO m SELECT i, i::VARCHAR, 5 FROM range(400000, 400010) t(i)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR), SUM(k) FROM m
----
130010	39503800045	130010	520050

statement ok
DROP TABLE m

statement ok
CHECKPOINT

# a concurrent checkpoint: the ALTER commits while it is paused, then rows are appended before it publishes
statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE p AS SELECT i, i::VARCHAR AS s FROM range(1000) t(i)

statement ok
CHECKPOINT

statement ok con1
BEGIN

query I con1
SELECT COUNT(*) FROM p
----
1000

statement ok
INSERT INTO p SELECT i, i::VARCHAR FROM range(1000, 1100) t(i)

statement ok
SET debug_checkpoint_scan_sleep_ms=2000

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
CHECKPOINT

sleep 700 millisecond

onlyif threadid=1
statement ok
ALTER TABLE p ADD COLUMN k INTEGER DEFAULT 1

onlyif threadid=1
statement ok
INSERT INTO p VALUES (5000, 'x', 2)

endloop

statement ok
SET debug_checkpoint_scan_sleep_ms=0

statement error con1
SELECT k FROM p
----
not found

statement ok con1
COMMIT

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR), SUM(k) FROM p
----
1101	609450	1100	1102

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR), SUM(k) FROM p
----
1101	609450	1100	1102
