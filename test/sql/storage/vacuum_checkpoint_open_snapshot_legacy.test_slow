# name: test/sql/storage/vacuum_checkpoint_open_snapshot_legacy.test_slow
# description: Storage versions that renumber row ids: no checkpoint vacuums while an older snapshot is open
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_legacy.db readwrite v1.0.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

statement ok
CREATE TABLE other (i BIGINT);

# nine row groups
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

# the first two row groups lose all rows, the others keep one row in ten
statement ok
DELETE FROM test WHERE i < 245760 OR i % 10 <> 0

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
79872	51526625280

# committed after the snapshot started: a read, an insert into another table, a delete in the fifth row group
query I
SELECT COUNT(*) FROM other
----
0

statement ok
INSERT INTO other VALUES (42)

statement ok
DELETE FROM test WHERE i = 500000

statement ok
CHECKPOINT

# inserts hold the vacuum lock on these storage versions, so the checkpoint leaves every row group as it is
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
9

query III con2
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
79872	51526625280	true

query I con2
SELECT COUNT(*) FROM test WHERE i = 500000
----
1

query I con2
SELECT COUNT(*) FROM other
----
0

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid), MAX(rowid) FROM test
----
79871	51526125280	true	1044470

statement ok con2
COMMIT

# the next checkpoint drops and merges the row groups, and renumbers the rows
statement ok
DELETE FROM test WHERE i = 500010

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid), MAX(rowid) FROM test
----
79870	51525625270	true	79869

restart

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid), MAX(rowid) FROM test
----
79870	51525625270	true	79869
