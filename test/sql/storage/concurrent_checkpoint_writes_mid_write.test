# name: test/sql/storage/concurrent_checkpoint_writes_mid_write.test
# description: Inserts, deletes and updates run while the checkpoint writes their table, and land in the rewritten table
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_writes_mid_write.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

statement ok
INSERT INTO test SELECT i, 'str' || i FROM range(50000) t(i);

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint pauses for eight seconds after it scanned the row groups, before it replaces them
statement ok
SET debug_checkpoint_scan_sleep_ms=8000

# ---------------------------------------------------------------------------------------------------------------------
# autocommit statements during the pause: none of them wait for the checkpoint
# ---------------------------------------------------------------------------------------------------------------------
# a committed update makes the checkpoint rewrite the row group the concurrent statements hit
statement ok
UPDATE test SET s = 'pre' WHERE i = 0

# every thread executes every sleep: the sleeps are the schedule
concurrentloop threadid 0 5

# thread 4 keeps a write transaction open while the checkpoint starts, so that it is a concurrent checkpoint (a full
# checkpoint holds the vacuum lock and blocks every writer)
onlyif threadid=4
statement ok
BEGIN TRANSACTION

onlyif threadid=4
statement ok
UPDATE test SET s = s WHERE i = -1

sleep 1500 millisecond

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint', now())

sleep 1500 millisecond

onlyif threadid=4
statement ok
ROLLBACK

onlyif threadid=1
statement ok
INSERT INTO test SELECT i, 'inserted' FROM range(100000, 101000) t(i)

onlyif threadid=2
statement ok
DELETE FROM test WHERE i >= 10000 AND i < 11000

onlyif threadid=3
statement ok
UPDATE test SET i = i + 1000000, s = 'updated' WHERE i >= 20000 AND i < 21000

onlyif threadid>0&&threadid<4
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

endloop

# the writers finished during the pause, long before the checkpoint did (a writer waiting for the table would
# finish after the pause)
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing c WHERE w.who = 'writer' AND c.who = 'checkpoint' AND w.t < c.t - INTERVAL 4 SECOND
----
3

query IIII
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'inserted'), COUNT(*) FILTER (WHERE i >= 10000 AND i < 11000), COUNT(*) FILTER (WHERE s = 'updated') FROM test
----
50000	1000	0	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2339975000	true

# the update went through the old table: its statistics still cover it
query I
SELECT MAX(i) FROM test
----
1020999

# WAL replay of the concurrent commits
restart

query IIII
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'inserted'), COUNT(*) FILTER (WHERE i >= 10000 AND i < 11000), COUNT(*) FILTER (WHERE s = 'updated') FROM test
----
50000	1000	0	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2339975000	true

statement ok
SET debug_checkpoint_scan_sleep_ms=0

statement ok
CHECKPOINT

restart

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2339975000	true

# ---------------------------------------------------------------------------------------------------------------------
# a transaction that inserted before the checkpoint commits during the pause; another rolls back during it
# ---------------------------------------------------------------------------------------------------------------------
statement ok
SET debug_checkpoint_scan_sleep_ms=8000

statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

statement ok
UPDATE test SET s = 'pre2' WHERE i = 1

concurrentloop threadid 0 3

onlyif threadid>0
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
INSERT INTO test SELECT i, 'committed' FROM range(200000, 201000) t(i)

onlyif threadid=2
statement ok
INSERT INTO test SELECT i, 'rolled back' FROM range(300000, 301000) t(i)

onlyif threadid=2
statement ok
UPDATE test SET s = 'rolled back' WHERE i >= 30000 AND i < 31000

onlyif threadid=2
statement ok
DELETE FROM test WHERE i >= 40000 AND i < 41000

sleep 1500 millisecond

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint', now())

sleep 1500 millisecond

onlyif threadid=1
statement ok
COMMIT

onlyif threadid=2
statement ok
ROLLBACK

onlyif threadid>0
statement ok
INSERT INTO mem.timing VALUES ('writer', now())

endloop

query I
SELECT COUNT(*) FROM mem.timing w, mem.timing c WHERE w.who = 'writer' AND c.who = 'checkpoint' AND w.t < c.t - INTERVAL 4 SECOND
----
2

query IIII
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'committed'), COUNT(*) FILTER (WHERE s = 'rolled back'), COUNT(*) FILTER (WHERE i >= 40000 AND i < 41000) FROM test
----
51000	1000	0	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2540474500	true

restart

query IIII
SELECT COUNT(*), COUNT(*) FILTER (WHERE s = 'committed'), COUNT(*) FILTER (WHERE s = 'rolled back'), COUNT(*) FILTER (WHERE i >= 40000 AND i < 41000) FROM test
----
51000	1000	0	1000

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2540474500	true

statement ok
SET debug_checkpoint_scan_sleep_ms=0

statement ok
CHECKPOINT

restart

query II
SELECT SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
2540474500	true
