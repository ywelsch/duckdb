# name: test/sql/storage/alter_concurrent_checkpoint_replay.test
# description: Writes logged after an ALTER that was open during a checkpoint replay from the WAL
# group: [storage]

require skip_reload

load {TEST_DIR}/alter_concurrent_checkpoint_replay.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

# merged by the checkpoint while the ALTER is open
statement ok
CREATE TABLE merged AS SELECT i, i::VARCHAR AS s FROM range(400000) t(i)

# rewritten, not merged
statement ok
CREATE TABLE rewritten AS SELECT i, i::VARCHAR AS s FROM range(1000) t(i)

statement ok
CREATE TABLE keyed (i INTEGER PRIMARY KEY, s VARCHAR)

statement ok
INSERT INTO keyed SELECT i, i::VARCHAR FROM range(20000) t(i)

statement ok
CHECKPOINT

statement ok
DELETE FROM merged WHERE i < 300000 AND i % 10 <> 0

statement ok
DELETE FROM keyed WHERE i < 15000 AND i % 10 <> 0

statement ok
INSERT INTO rewritten SELECT i, i::VARCHAR FROM range(1000, 1100) t(i)

# nothing commits after the transactions start: the checkpoint is a full one
statement ok con1
BEGIN

statement ok con1
ALTER TABLE merged ADD COLUMN k INTEGER DEFAULT 1

statement ok con1
ALTER TABLE rewritten ADD COLUMN k INTEGER DEFAULT 1

statement ok con1
ALTER TABLE keyed ADD COLUMN k INTEGER DEFAULT 1

statement ok
CHECKPOINT

statement ok con1
COMMIT

# logged by row id after the checkpoint, replayed against what it wrote
foreach t merged rewritten keyed

statement ok
DELETE FROM {t} WHERE i % 20 = 0

statement ok
UPDATE {t} SET s = 'u' || i WHERE i % 30 = 0

statement ok
INSERT INTO {t} VALUES (500000, 'x', 2)

endloop

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM merged
----
110001	35500500000	6667	110002

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM rewritten
----
1046	1074750	18	1047

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM keyed
----
5501	89250000	333	5502

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM merged
----
110001	35500500000	6667	110002

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM rewritten
----
1046	1074750	18	1047

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = 'u' || i), SUM(k) FROM keyed
----
5501	89250000	333	5502

query II
SELECT i, k FROM keyed WHERE i = 15001
----
15001	1

statement error
INSERT INTO keyed VALUES (15003, 'dup', 3)
----
Duplicate key

statement ok
CHECKPOINT
