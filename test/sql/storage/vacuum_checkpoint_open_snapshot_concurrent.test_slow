# name: test/sql/storage/vacuum_checkpoint_open_snapshot_concurrent.test_slow
# description: Snapshots stay stable while checkpoints vacuum around the rows inserted or deleted after they started
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_concurrent.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

statement ok
DELETE FROM test WHERE i % 100 <> 0

# thread 0 checkpoints, threads 1 and 2 insert, thread 3 deletes, threads 4 to 6 hold a snapshot over several checkpoints
concurrentloop threadid 0 7

loop x 0 30

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid>=1&&threadid<=2
statement ok
INSERT INTO test SELECT {threadid} * 100000000 + {x} * 10000 + range FROM range(3000)

# one of the rows left in the first eight row groups
onlyif threadid=3
statement ok
DELETE FROM test WHERE i = {x} * 30000

onlyif threadid>=4
statement ok
BEGIN TRANSACTION

onlyif threadid>=4
statement ok
SET VARIABLE snapshot=(SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test)

loop y 0 5

onlyif threadid>=4
statement ok
SELECT sleep_ms(20 + (random() * 40)::BIGINT)

onlyif threadid>=4
query I
SELECT CASE
	WHEN {'count': COUNT(*), 'sum': SUM(i)} = getvariable('snapshot')
	THEN NULL
	ELSE {'now': {'count': COUNT(*), 'sum': SUM(i)}, 'snapshot': getvariable('snapshot')}
	END
FROM test
----
NULL

endloop

onlyif threadid>=4
statement ok
COMMIT

endloop

endloop

query III
SELECT COUNT(*), COUNT(*) = COUNT(DISTINCT rowid), COUNT(*) = COUNT(DISTINCT i) FROM test
----
190415	true	true

statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), COUNT(*) = COUNT(DISTINCT rowid), COUNT(*) = COUNT(DISTINCT i) FROM test
----
190415	true	true
