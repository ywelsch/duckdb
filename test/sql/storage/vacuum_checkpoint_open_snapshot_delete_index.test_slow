# name: test/sql/storage/vacuum_checkpoint_open_snapshot_delete_index.test_slow
# description: A delete from an indexed table that an open snapshot does not see stops the vacuum of its row group only
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_delete_index.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT PRIMARY KEY);

# nine row groups
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

# the first two row groups lose all rows
statement ok
DELETE FROM test WHERE i < 245760

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
798720	515269847040

# the deleting transaction stays around until its index entries are cleaned up: its row group keeps the version info
statement ok
DELETE FROM test WHERE i = 500000

statement ok
CHECKPOINT

# the two empty row groups are dropped
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
7

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
798720	515269847040

query I con2
SELECT i FROM test WHERE i = 500000
----
500000

query I
SELECT i FROM test WHERE i = 500000
----

statement ok con2
COMMIT

statement ok
DELETE FROM test WHERE i = 500010

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
7

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
798718	515268847030	true
