# name: test/sql/storage/vacuum_checkpoint_forwarded_deletes.test_slow
# description: A transaction keeps its row ids while checkpoints merge row groups: its deletes go to the merged row groups
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_forwarded_deletes.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE tick (i BIGINT);

# five row groups each
foreach tbl f conflict chain rolled_back refused

statement ok
CREATE TABLE {tbl} (i BIGINT, s VARCHAR);

statement ok
INSERT INTO {tbl} SELECT i, 'base' FROM range(614400) t(i);

endloop

statement ok
CREATE TABLE wide (i BIGINT);

statement ok
INSERT INTO wide SELECT i FROM range(368640) t(i);

statement ok
CREATE TABLE keyed (i BIGINT PRIMARY KEY, s VARCHAR);

statement ok
INSERT INTO keyed SELECT i, 'base' FROM range(614400) t(i);

statement ok
CHECKPOINT

# the last three row groups keep a tenth of their rows (each table right before it is used)
foreach tbl f keyed

statement ok
DELETE FROM {tbl} WHERE i >= 245760 AND i % 10 <> 0

endloop

# a transaction asks for row ids, a checkpoint merges, the transaction deletes by those row ids
statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM f WHERE i = 400000
----
400000	400000

query II con1
SELECT rowid, i FROM keyed WHERE i = 400000
----
400000	400000

statement ok con2
CHECKPOINT

query III con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('f')), (SELECT rowid FROM f WHERE i = 400000), (SELECT rowid FROM keyed WHERE i = 400000)
----
3	261184	261184

query II con1
SELECT rowid, i FROM f WHERE i = 400000
----
400000	400000

statement ok con1
DELETE FROM f WHERE rowid = 400000

statement ok con1
DELETE FROM keyed WHERE rowid = 400000

query III con1
SELECT COUNT(*), COUNT(*) FILTER (i = 400000), (SELECT rowid FROM f WHERE i = 400010) FROM f
----
282623	0	400010

query I con1
SELECT COUNT(*) FROM f
----
282623

query II con1
SELECT COUNT(*), COUNT(*) FILTER (i = 400000) FROM keyed
----
282623	0

query II con2
SELECT COUNT(*), COUNT(*) FILTER (i = 400000) FROM f
----
282624	1

statement ok con1
COMMIT

query III con2
SELECT COUNT(*), COUNT(*) FILTER (i = 400000), (SELECT rowid FROM f WHERE i = 400010) FROM f
----
282623	0	261185

query II con2
SELECT COUNT(*), COUNT(*) FILTER (i = 400000) FROM keyed
----
282623	0

statement ok con2
INSERT INTO keyed VALUES (400000, 'again')

statement error con2
INSERT INTO keyed VALUES (400010, 'duplicate')
----
<REGEX>:.*Duplicate key.*

# the same row deleted through the old and through the merged row groups: one of them conflicts
statement ok
DELETE FROM conflict WHERE i >= 245760 AND i % 10 <> 0

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM conflict WHERE i = 400000
----
400000	400000

statement ok con2
CHECKPOINT

statement ok con3
BEGIN

statement ok con3
DELETE FROM conflict WHERE i = 400000

statement error con1
DELETE FROM conflict WHERE rowid = 400000
----
<REGEX>:.*Conflict.*

statement ok con1
ROLLBACK

statement ok con3
COMMIT

query II con2
SELECT COUNT(*), COUNT(*) FILTER (i = 400000) FROM conflict
----
282623	0

# a rolled back delete through the old row groups
statement ok
DELETE FROM rolled_back WHERE i >= 245760 AND i % 10 <> 0

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM rolled_back WHERE i = 400000
----
400000	400000

statement ok con2
CHECKPOINT

statement ok con1
DELETE FROM rolled_back WHERE rowid = 400000

query I con1
SELECT COUNT(*) FROM rolled_back WHERE i = 400000
----
0

statement ok con1
ROLLBACK

query II con2
SELECT COUNT(*), (SELECT rowid FROM rolled_back WHERE i = 400000) FROM rolled_back
----
282624	261184

# updates are not forwarded yet
statement ok
DELETE FROM refused WHERE i >= 245760 AND i % 10 <> 0

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM refused WHERE i = 400000
----
400000	400000

statement ok con2
CHECKPOINT

statement error con1
UPDATE refused SET s = 'changed' WHERE rowid = 400000
----
<REGEX>:.*Cannot update table.*

statement ok con1
ROLLBACK

# two merges while the transaction is open: the first one is kept from the first row group by an open delete
statement ok
DELETE FROM chain WHERE i % 10 <> 0

statement ok con3
BEGIN

statement ok con3
DELETE FROM chain WHERE i = 10

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM chain WHERE i IN (300000, 500000) ORDER BY i
----
300000	300000
500000	500000

statement ok con2
CHECKPOINT

statement ok con3
ROLLBACK

statement ok con2
INSERT INTO tick VALUES (1)

statement ok con2
CHECKPOINT

query III con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('chain')), (SELECT rowid FROM chain WHERE i = 300000), (SELECT rowid FROM chain WHERE i = 500000)
----
1	30000	50000

statement ok con1
DELETE FROM chain WHERE rowid IN (300000, 500000)

query III con1
SELECT COUNT(*), COUNT(*) FILTER (i IN (300000, 500000)), (SELECT rowid FROM chain WHERE i = 300010) FROM chain
----
61438	0	300010

statement ok con1
COMMIT

query III con2
SELECT COUNT(*), COUNT(*) FILTER (i IN (300000, 500000)), (SELECT rowid FROM chain WHERE i = 300010) FROM chain
----
61438	0	30001

# a merged row group without any version info of its own (loaded from disk): a count without a filter, taken from
# the row group statistics, does not take its row count
restart

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
DELETE FROM wide WHERE i >= 122880 AND i % 10 <> 0

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM wide WHERE i = 100
----
100	100

statement ok con2
CHECKPOINT

query II con2
SELECT COUNT(DISTINCT row_group_id), COUNT(*) FROM pragma_storage_info('wide') WHERE segment_type = 'BIGINT'
----
2	2

statement ok con1
DELETE FROM wide WHERE rowid = 100

query I con1
SELECT COUNT(*) FROM wide
----
147455

statement ok con1
COMMIT

query I con2
SELECT COUNT(*) FROM wide
----
147455

# the deletes replay from the write-ahead log
restart

query IIII
SELECT (SELECT COUNT(*) FROM f), (SELECT COUNT(*) FROM keyed), (SELECT COUNT(*) FROM conflict), (SELECT COUNT(*) FROM chain)
----
282623	282624	282623	61438

query IIII
SELECT (SELECT COUNT(*) FROM f WHERE i = 400000), (SELECT COUNT(*) FROM keyed WHERE i = 400000), (SELECT s FROM keyed WHERE i = 400000), (SELECT COUNT(*) FROM chain WHERE i IN (300000, 500000))
----
0	1	again	0

statement ok
CHECKPOINT

restart

query IIII
SELECT (SELECT COUNT(*) FROM f), (SELECT COUNT(*) FROM keyed), (SELECT COUNT(*) FROM rolled_back), (SELECT COUNT(*) FROM chain)
----
282623	282624	282624	61438
