# name: test/sql/storage/vacuum_checkpoint_row_id_holds.test_slow
# description: Row ids in use keep merges out of their own table only, also when they are taken after the merge was planned
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_row_id_holds.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE tick (i BIGINT);

# five row groups each, of which the last three keep a tenth of their rows once thinned
foreach tbl held free deleted planned scanned selfref

statement ok
CREATE TABLE {tbl} (i BIGINT, s VARCHAR);

statement ok
INSERT INTO {tbl} SELECT i, 'base' FROM range(614400) t(i);

endloop

statement ok
CHECKPOINT

# a transaction that asked for row ids of one table: the other table is merged
foreach tbl held free

statement ok
DELETE FROM {tbl} WHERE i >= 245760 AND i % 10 <> 0

endloop

statement ok con1
BEGIN

query II con1
SELECT rowid, i FROM held WHERE i = 400000
----
400000	400000

statement ok con2
CHECKPOINT

query II con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('held')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('free'))
----
5	3

query II con1
SELECT rowid, i FROM held WHERE i = 400000
----
400000	400000

statement ok con1
COMMIT

# an open transaction that deleted rows keeps the row group it deleted in, the others are merged
statement ok
DELETE FROM deleted WHERE i >= 245760 AND i % 10 <> 0

statement ok con1
BEGIN

statement ok con1
DELETE FROM deleted WHERE i = 300000

statement ok con2
CHECKPOINT

query II con2
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('deleted')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('held'))
----
4	3

statement ok con1
COMMIT

statement ok
INSERT INTO tick VALUES (0)

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('deleted')
----
3

# row ids asked for after the merge was planned: the merge is not sealed
statement ok
DELETE FROM planned WHERE i >= 245760 AND i % 10 <> 0

statement ok
SET debug_checkpoint_seal_sleep_ms=3000

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

onlyif threadid=1
statement ok
BEGIN

onlyif threadid=1
query II
SELECT rowid, i FROM planned WHERE i = 400000
----
400000	400000

sleep 4000 millisecond

onlyif threadid=1
query II
SELECT rowid, i FROM planned WHERE i = 400000
----
400000	400000

onlyif threadid=1
statement ok
COMMIT

endloop

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('planned')
----
5

statement ok
SET debug_checkpoint_seal_sleep_ms=0

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('planned')
----
3

statement ok
SET debug_checkpoint_seal_sleep_ms=3000

# a delete whose scan runs while the merge is sealed: the merge waits for a later checkpoint, the delete hits
# the rows it scanned
statement ok
DELETE FROM scanned WHERE i >= 245760 AND i % 10 <> 0

statement ok
SET threads=1

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
CHECKPOINT

sleep 500 millisecond

onlyif threadid=1
statement ok
DELETE FROM scanned WHERE i = 450000 OR (i = 100 AND sleep_ms(4000) IS NULL)

endloop

query III
SELECT COUNT(*), SUM(i), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('scanned')) FROM scanned
----
282622	46052700620	5

query I
SELECT COUNT(*) FROM scanned WHERE i IN (100, 450000)
----
0

statement ok
SET debug_checkpoint_seal_sleep_ms=0

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('scanned')
----
3

# a delete that scans its table without row ids first (the subquery) and with row ids after the merge was due
statement ok
DELETE FROM selfref WHERE i >= 245760 AND i % 10 <> 0

statement ok
SET debug_checkpoint_seal_sleep_ms=3000

concurrentloop threadid 0 2

onlyif threadid=0
statement ok
CHECKPOINT

sleep 500 millisecond

onlyif threadid=1
statement ok
DELETE FROM selfref WHERE i = 450000 AND i IN (SELECT i FROM selfref WHERE i = 450000 OR (i = 100 AND sleep_ms(4000) IS NULL))

endloop

statement ok
SET debug_checkpoint_seal_sleep_ms=0

query III
SELECT COUNT(*), SUM(i), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('selfref')) FROM selfref
----
282623	46052700720	5

# once nothing holds them, the row groups are merged
statement ok
INSERT INTO tick VALUES (3)

statement ok
CHECKPOINT

query IIIII
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('held')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('deleted')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('planned')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('scanned')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('free'))
----
3	3	3	3	3

query II
SELECT (SELECT rowid FROM planned WHERE i = 400000), (SELECT rowid FROM scanned WHERE i = 400000)
----
261184	261184

restart

query IIII
SELECT (SELECT COUNT(*) FROM held), (SELECT COUNT(*) FROM deleted), (SELECT COUNT(*) FROM planned), (SELECT SUM(i) FROM scanned)
----
282624	282623	282624	46052700620
