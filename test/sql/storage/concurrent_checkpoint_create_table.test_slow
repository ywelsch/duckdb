# name: test/sql/storage/concurrent_checkpoint_create_table.test_slow
# description: Tables, indexes and primary keys created while a checkpoint runs are not part of it, and replay from the WAL
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_create_table.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t AS SELECT i FROM range(200000) t(i);

statement ok
CREATE TABLE w AS SELECT i FROM range(1000) t(i);

statement ok
CHECKPOINT

# an index that is still uncommitted while a checkpoint runs, and is then rolled back
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE INDEX idx ON t(i)

statement ok
INSERT INTO t VALUES (-1)

statement ok
CHECKPOINT

statement ok con1
ROLLBACK

statement ok
INSERT INTO t VALUES (-2)

restart

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_indexes()
----
0

# the checkpoint verifies that it accounts for every block: the rolled back index must not have left any behind
statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM t
----
200002

# a unique index that commits during a checkpoint, while another connection inserts into its table
statement ok
CREATE TABLE u AS SELECT i FROM range(20000) t(i);

statement ok
SET debug_checkpoint_sleep_ms=4000

concurrentloop threadid 0 3

# the index is built and attached long before the insert below
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
CREATE UNIQUE INDEX uidx ON u(i)

sleep 2000 millisecond

onlyif threadid=0
statement ok
INSERT INTO u VALUES (-3)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1500 millisecond

onlyif threadid=2
statement ok
INSERT INTO u VALUES (5000000)

sleep 1000 millisecond

onlyif threadid=1
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

loop k 0 2

query I
SELECT COUNT(*) FROM u WHERE i = 5000000
----
1

statement error
INSERT INTO u VALUES (5000000)
----
violates unique constraint

statement error
INSERT INTO u VALUES (7)
----
violates unique constraint

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM u
----
20002	20002

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

endloop

statement ok
INSERT INTO t VALUES (-4)

statement ok
CHECKPOINT

restart

statement error
INSERT INTO u VALUES (5000000)
----
violates unique constraint

# a table with row groups written before its commit, a table with a primary key, and a primary key added to a table,
# all committed while the checkpoint sleeps before its catalog scan
statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 3

# thread 2 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
query I
SELECT COUNT(*) FROM w
----
1000

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-10)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1000 millisecond

onlyif threadid=1
statement ok
CREATE TABLE big AS SELECT i FROM range(300000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE pk (id INTEGER PRIMARY KEY)

onlyif threadid=1
statement ok
INSERT INTO pk SELECT i FROM range(1000) t(i)

onlyif threadid=1
statement ok
ALTER TABLE w ADD PRIMARY KEY (i)

sleep 4000 millisecond

onlyif threadid=2
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

loop k 0 2

query III
SELECT COUNT(*), SUM(i), MAX(i) FROM big
----
300000	44999850000	299999

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM pk
----
1000	1000

statement error
INSERT INTO pk VALUES (7)
----
violates primary key constraint

statement error
INSERT INTO w VALUES (7)
----
violates primary key constraint

# replay the WAL as after a crash
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

endloop

statement ok
INSERT INTO t VALUES (-11)

# the checkpoint accounts for every block, also those of the table created during the previous one
statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), SUM(i), MAX(i) FROM big
----
300000	44999850000	299999

statement error
INSERT INTO pk VALUES (7)
----
violates primary key constraint

statement error
INSERT INTO w VALUES (7)
----
violates primary key constraint
