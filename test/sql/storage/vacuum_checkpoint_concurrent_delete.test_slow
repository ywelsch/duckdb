# name: test/sql/storage/vacuum_checkpoint_concurrent_delete.test_slow
# description: Deletes run and commit while a checkpoint merges row groups
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_concurrent_delete.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i INTEGER, s VARCHAR);

# five row groups
statement ok
INSERT INTO test SELECT i, 'base' FROM range(614400) t(i);

statement ok
CHECKPOINT

# every row group keeps a tenth of its rows
statement ok
DELETE FROM test WHERE i % 10 <> 0

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for six seconds after it became active, before it writes any table, and again for six
# seconds after it merged the row groups, before it writes the header
statement ok
SET debug_checkpoint_sleep_ms=6000

statement ok
SET debug_checkpoint_scan_sleep_ms=6000

concurrentloop threadid 0 6

sleep 1000 millisecond

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint start', now())

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 2000 millisecond

# during the first sleep: a delete in the first row group, which the checkpoint then keeps as it is
onlyif threadid=1
statement ok
DELETE FROM test WHERE i = 0

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('first', now())

# during the first sleep: a transaction deletes in the second row group, which is kept as well
# once it has committed it no longer holds the merges back
onlyif threadid=4
statement ok
BEGIN

onlyif threadid=4
statement ok
DELETE FROM test WHERE i = 130000

onlyif threadid=4
statement ok
COMMIT

onlyif threadid=4
statement ok
INSERT INTO mem.timing VALUES ('transaction', now())

sleep 6000 millisecond

# during the second sleep: the last three row groups are merged, the header is not written yet

# a delete in a row group that was kept, and an insert
onlyif threadid=2
statement ok
DELETE FROM test WHERE i = 10

onlyif threadid=2
statement ok
INSERT INTO test VALUES (-1, 'during')

onlyif threadid=2
statement ok
INSERT INTO mem.timing VALUES ('second', now())

# a delete in the merged row group that is rolled back
onlyif threadid=5
statement ok
BEGIN

onlyif threadid=5
statement ok
DELETE FROM test WHERE i = 400000

onlyif threadid=5
statement ok
ROLLBACK

onlyif threadid=5
statement ok
INSERT INTO mem.timing VALUES ('rollback', now())

# a delete in the merged row group: its commit waits until the checkpoint is durable
onlyif threadid=3
statement ok
DELETE FROM test WHERE i = 300000

onlyif threadid=3
statement ok
INSERT INTO mem.timing VALUES ('third', now())

endloop

# the first two deletes committed while the checkpoint slept the first time
query I
SELECT COUNT(*) FROM mem.timing f, mem.timing s WHERE f.who IN ('first', 'transaction') AND s.who = 'checkpoint start' AND f.t > s.t AND f.t < s.t + INTERVAL 6 SECOND
----
2

# these finished while the checkpoint slept the second time
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s, mem.timing e WHERE w.who IN ('second', 'rollback') AND s.who = 'checkpoint start' AND e.who = 'checkpoint end' AND w.t > s.t + INTERVAL 6 SECOND AND w.t < e.t - INTERVAL 2 SECOND
----
2

# the delete in the merged row group started during the second sleep and committed when the checkpoint was done
query I
SELECT COUNT(*) FROM mem.timing w, mem.timing s WHERE w.who = 'third' AND s.who = 'checkpoint start' AND w.t > s.t + INTERVAL 11 SECOND
----
1

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
SET debug_checkpoint_scan_sleep_ms=0

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
61437	18873630789	true

# the last three row groups were merged into one that starts where the first of them started
query III
SELECT min(rowid), max(rowid), COUNT(*) FROM test WHERE i >= 245760
----
245760	282623	36863

# rows of the two row groups that were kept have their row ids, the rows of the others moved
query II
SELECT rowid, i FROM test WHERE i IN (-1, 20, 122880, 130010, 300010, 400000, 614390) ORDER BY i
----
614400	-1
20	20
122880	122880
130010	130010
251185	300010
261184	400000
282623	614390

query I
SELECT COUNT(*) FROM test WHERE i IN (0, 10, 130000, 300000)
----
0

# WAL replay of the deletes and the insert on top of the merged row groups
restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
61437	18873630789	true

query II
SELECT rowid, i FROM test WHERE i IN (-1, 20, 122880, 130010, 300010, 400000, 614390) ORDER BY i
----
614400	-1
20	20
122880	122880
130010	130010
251185	300010
261184	400000
282623	614390

query I
SELECT COUNT(*) FROM test WHERE i IN (0, 10, 130000, 300000)
----
0

# changes that address moved rows by row id
statement ok
DELETE FROM test WHERE i = 300010

statement ok
UPDATE test SET s = 'updated' WHERE i = 400000

# this checkpoint merges the row groups the first one kept
statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
61436	18873330779	true

query III
SELECT min(rowid), max(rowid), COUNT(*) FROM test WHERE s <> 'during'
----
0	61434	61435

query II
SELECT i, s FROM test WHERE i IN (-1, 300000, 300010, 400000) ORDER BY i
----
-1	during
400000	updated

statement ok
INSERT INTO test VALUES (-2, 'after')

query I
SELECT rowid FROM test WHERE i = -2
----
614401
