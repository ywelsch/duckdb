# name: test/sql/storage/checkpoint_with_open_drop.test_slow
# description: A transaction that dropped a table or index takes the checkpoint lock when it commits, not before
# group: [storage]

load {TEST_DIR}/checkpoint_with_open_drop.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE a (i INTEGER PRIMARY KEY, s VARCHAR)

statement ok
INSERT INTO a SELECT i, 'a' || i FROM range(100000) t(i)

statement ok
CREATE TABLE b (i INTEGER, s VARCHAR)

statement ok
INSERT INTO b SELECT i, 'b' || i FROM range(100000) t(i)

statement ok
CREATE INDEX b_s ON b(s)

statement ok
CREATE TABLE c AS SELECT i FROM range(1000) t(i)

statement ok
CREATE TABLE keep AS SELECT i FROM range(1000) t(i)

statement ok
CREATE SEQUENCE seq

statement ok
CHECKPOINT

# an open transaction that dropped a table and an index does not hold a checkpoint back
statement ok con1
BEGIN TRANSACTION

statement ok con1
DROP TABLE a

statement ok con1
DROP INDEX b_s

statement ok
INSERT INTO keep VALUES (-1)

statement ok
CHECKPOINT

statement ok con1
ROLLBACK

# the checkpoint wrote the table and the index
restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

query II
SELECT COUNT(*), SUM(i) FROM a
----
100000	4999950000

query I
SELECT COUNT(*) FROM duckdb_indexes() WHERE index_name = 'b_s'
----
1

# the same, and the drops commit after the checkpoint
statement ok con1
BEGIN TRANSACTION

statement ok con1
DROP TABLE a

statement ok con1
DROP INDEX b_s

statement ok
INSERT INTO keep VALUES (-2)

statement ok
CHECKPOINT

statement ok con1
COMMIT

statement ok
INSERT INTO keep VALUES (-3)

statement ok
CHECKPOINT

# as before: no checkpoint while an older transaction can still read a dropped table
statement ok con2
BEGIN TRANSACTION

query I con2
SELECT COUNT(*) FROM b
----
100000

statement ok
DROP TABLE b

statement error
CHECKPOINT
----
Cannot CHECKPOINT: there are other write transactions active

query II con2
SELECT COUNT(*), SUM(i) FROM b
----
100000	4999950000

statement ok con2
COMMIT

statement ok
CHECKPOINT

# a checkpoint that sleeps for three seconds before it scans the catalog
statement ok
SET debug_checkpoint_sleep_ms=3000

concurrentloop threadid 0 4

# thread 3 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=3
statement ok
BEGIN TRANSACTION

onlyif threadid=3
query I
SELECT COUNT(*) FROM c
----
1000

onlyif threadid=1
statement ok
BEGIN TRANSACTION

sleep 300 millisecond

onlyif threadid=0
statement ok
INSERT INTO keep VALUES (-4)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 700 millisecond

# the statement does not wait for the running checkpoint: the sequence is used right after it
onlyif threadid=1
statement ok
DROP TABLE c

onlyif threadid=1
query I
SELECT nextval('seq')
----
1

sleep 500 millisecond

onlyif threadid=2
query I
SELECT last_value FROM duckdb_sequences() WHERE sequence_name = 'seq'
----
1

onlyif threadid=2
statement error
CHECKPOINT
----
Cannot CHECKPOINT

# the commit waits for the checkpoint
onlyif threadid=1
statement ok
COMMIT

sleep 1000 millisecond

onlyif threadid=2
query I
SELECT COUNT(*) FROM c
----
1000

sleep 3000 millisecond

onlyif threadid=2
statement error
SELECT COUNT(*) FROM c
----
does not exist

# the reader still reads the dropped table
onlyif threadid=3
query II
SELECT COUNT(*), SUM(i) FROM c
----
1000	499500

onlyif threadid=3
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
INSERT INTO keep VALUES (-5)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE table_name IN ('a', 'b', 'c')
----
0

query I
SELECT COUNT(*) FROM keep
----
1005

# the checkpoint accounts for every block, also those of the dropped tables and the index
statement ok
INSERT INTO keep VALUES (-6)

statement ok
CHECKPOINT
