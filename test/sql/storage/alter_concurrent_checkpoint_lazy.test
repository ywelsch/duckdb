# name: test/sql/storage/alter_concurrent_checkpoint_lazy.test
# description: An uncommitted ALTER takes over the row groups a checkpoint rewrote, including columns not loaded yet
# group: [storage]

require skip_reload

# column metadata is reused per column, so unloaded columns stay unloaded through ALTER and checkpoint
load {TEST_DIR}/alter_concurrent_checkpoint_lazy.db readwrite latest

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET force_compression='uncompressed'

statement ok
CREATE TABLE t AS SELECT i, repeat(md5(i::VARCHAR), 160) AS s, i * 2 AS v FROM range(3000) t(i)

statement ok
CREATE TABLE filler (i INTEGER, s VARCHAR)

statement ok
CHECKPOINT

# the columns are loaded from disk only when read
restart

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET force_compression='uncompressed'

# deletes change the row group: the checkpoint rewrites it, and reuses the columns it did not load
statement ok
DELETE FROM t WHERE i % 7 = 0

# a column with updates is rewritten by the checkpoint, which frees its old blocks
statement ok
UPDATE t SET s = s WHERE i < 100

statement ok con1
BEGIN

statement ok con1
ALTER TABLE t ADD COLUMN k INTEGER DEFAULT 4

statement ok con1
ALTER TABLE t DROP COLUMN v

statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM pragma_storage_info('t', include_segment_info=true, loaded_segments_only=true) WHERE column_name = 'v'
----
0

statement ok con1
COMMIT

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = repeat(md5(i::VARCHAR), 160)), SUM(k) FROM t
----
2571	3855858	2571	10284

statement ok
SET debug_verify_blocks=true

statement ok
INSERT INTO filler SELECT i, repeat(md5((i + 7)::VARCHAR), 160) FROM range(3000) t(i)

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = repeat(md5(i::VARCHAR), 160)), SUM(k) FROM t
----
2571	3855858	2571	10284

query II
SELECT COUNT(*), COUNT(*) FILTER (s = repeat(md5((i + 7)::VARCHAR), 160)) FROM filler
----
3000	3000

statement ok
INSERT INTO t SELECT i, repeat(md5(i::VARCHAR), 160), 5 FROM range(3000, 3100) t(i)

statement ok
CHECKPOINT
