# name: test/sql/storage/vacuum_checkpoint_open_snapshot.test_slow
# description: A snapshot older than the last commit does not stop a checkpoint from vacuuming
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

statement ok
CREATE TABLE other (i BIGINT);

# nine row groups, the last one is half full
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
9

statement ok
DELETE FROM test WHERE i % 10 <> 0

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

# committed after the snapshot started: a read and an insert into another table
query I
SELECT COUNT(*) FROM other
----
0

statement ok
INSERT INTO other VALUES (42)

statement ok
CHECKPOINT

# the open snapshot sees the committed state of every row group of the table
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

query I con2
SELECT COUNT(*) FROM other
----
0

statement ok con2
COMMIT

query I con2
SELECT COUNT(*) FROM other
----
1

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104448	54546401280	true

query I
SELECT i FROM other
----
42
