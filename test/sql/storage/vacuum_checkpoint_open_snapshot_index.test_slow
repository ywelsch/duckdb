# name: test/sql/storage/vacuum_checkpoint_open_snapshot_index.test_slow
# description: Index lookups of an open snapshot after a checkpoint vacuumed around the row group it sees differently
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_index.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT PRIMARY KEY, s VARCHAR);

# nine row groups, the last one is half full
statement ok
INSERT INTO test SELECT range, 'base' FROM range(1044480);

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
9

# the first two row groups lose all rows, the others keep one row in a hundred
statement ok
DELETE FROM test WHERE i < 245760 OR i % 100 <> 0

# a new row group that the snapshot sees half of
statement ok
INSERT INTO test SELECT 1500000 + range, 'old' FROM range(5000);

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
12987	12664911200

statement ok
INSERT INTO test SELECT 2000000 + range, 'new' FROM range(5000);

statement ok
CHECKPOINT

# two row groups dropped, seven merged into one, the new one kept as it is
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
2

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
12987	12664911200

query I con2
SELECT COUNT(*) FROM test WHERE i >= 2000000
----
0

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
17987	22677408700	true

# a row of the merged row groups, a deleted row, the two halves of the kept row group
query II con2
SELECT i, s FROM test WHERE i = 300000
----
300000	base

query II con2
SELECT i, s FROM test WHERE i = 300001
----

query II con2
SELECT i, s FROM test WHERE i = 1500050
----
1500050	old

query II con2
SELECT i, s FROM test WHERE i = 2000050
----

query II
SELECT i, s FROM test WHERE i = 2000050
----
2000050	new

statement ok con2
COMMIT

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
17987	22677408700

# the next checkpoint merges the row group that was kept
statement ok
DELETE FROM test WHERE i = 2000000

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
17986	22675408700	true

query II
SELECT i, s FROM test WHERE i IN (300000, 300001, 1500050, 2000000, 2000050) ORDER BY i
----
300000	base
1500050	old
2000050	new

statement error
INSERT INTO test VALUES (2000050, 'duplicate')
----
<REGEX>:.*Constraint Error.*

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
17986	22675408700	true

query II
SELECT i, s FROM test WHERE i IN (300000, 300001, 1500050, 2000000, 2000050) ORDER BY i
----
300000	base
1500050	old
2000050	new

statement error
INSERT INTO test VALUES (300000, 'duplicate')
----
<REGEX>:.*Constraint Error.*

statement ok
INSERT INTO test VALUES (300001, 'again')
