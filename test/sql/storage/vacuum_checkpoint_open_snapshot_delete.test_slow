# name: test/sql/storage/vacuum_checkpoint_open_snapshot_delete.test_slow
# description: A checkpoint vacuums around the row group that holds a delete an open snapshot does not see
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_open_snapshot_delete.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT);

# nine row groups
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

statement ok
DELETE FROM test WHERE i % 10 <> 0

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
104448	54546401280

# deleted in the fifth row group, after the snapshot started
statement ok
DELETE FROM test WHERE i = 500000

statement ok
CHECKPOINT

# four row groups merged, the fifth kept, four merged
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
3

query III con2
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104448	54546401280	true

query I con2
SELECT COUNT(*) FROM test WHERE i = 500000
----
1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104447	54545901280	true

# the snapshot's own delete of a row that was deleted after it started still conflicts
statement error con2
DELETE FROM test WHERE i = 500000
----
<REGEX>:.*Conflict.*

statement ok con2
ROLLBACK

# the next checkpoint merges the row group that was kept
statement ok
DELETE FROM test WHERE i = 500010

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104446	54545401270	true

restart

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
104446	54545401270	true
