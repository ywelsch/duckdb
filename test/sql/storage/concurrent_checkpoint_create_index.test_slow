# name: test/sql/storage/concurrent_checkpoint_create_index.test_slow
# description: A checkpoint does not write indexes that commit after its bound, and does not route their changes to deltas
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_create_index.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t AS SELECT i FROM range(200000) t(i);

statement ok
CHECKPOINT

# an index that is still uncommitted while a checkpoint runs, and is then rolled back
statement ok con1
BEGIN TRANSACTION

statement ok con1
CREATE INDEX idx ON t(i)

statement ok
INSERT INTO t VALUES (-1)

statement ok
CHECKPOINT

statement ok con1
ROLLBACK

statement ok
INSERT INTO t VALUES (-2)

restart

statement ok
SET debug_verify_blocks=true

query I
SELECT COUNT(*) FROM duckdb_indexes()
----
0

# the checkpoint verifies that it accounts for every block: the rolled back index must not have left any behind
statement ok
CHECKPOINT

query I
SELECT COUNT(*) FROM t
----
200002

# a unique index that commits during a checkpoint, while another connection inserts into its table
statement ok
CREATE TABLE u AS SELECT i FROM range(20000) t(i);

statement ok
SET debug_checkpoint_sleep_ms=4000

concurrentloop threadid 0 3

# the index is built and attached long before the insert below
onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
CREATE UNIQUE INDEX uidx ON u(i)

sleep 2000 millisecond

onlyif threadid=0
statement ok
INSERT INTO u VALUES (-3)

onlyif threadid=0
statement ok
CHECKPOINT

sleep 1500 millisecond

onlyif threadid=2
statement ok
INSERT INTO u VALUES (5000000)

sleep 1000 millisecond

onlyif threadid=1
statement ok
COMMIT

endloop

statement ok
SET debug_checkpoint_sleep_ms=0

loop k 0 2

query I
SELECT COUNT(*) FROM u WHERE i = 5000000
----
1

statement error
INSERT INTO u VALUES (5000000)
----
violates unique constraint

statement error
INSERT INTO u VALUES (7)
----
violates unique constraint

query II
SELECT COUNT(*), COUNT(DISTINCT i) FROM u
----
20002	20002

restart

statement ok
PRAGMA disable_checkpoint_on_shutdown

endloop

statement ok
INSERT INTO t VALUES (-4)

statement ok
CHECKPOINT

restart

statement error
INSERT INTO u VALUES (5000000)
----
violates unique constraint
