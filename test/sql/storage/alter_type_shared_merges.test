# name: test/sql/storage/alter_type_shared_merges.test
# description: A full checkpoint merges the row groups of a table whose ALTER computed a column and is still open
# group: [storage]

require skip_reload

load {TEST_DIR}/alter_type_shared_merges.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE a AS SELECT i, i::VARCHAR AS s FROM range(400000) t(i)

statement ok
CREATE TABLE keyed (i INTEGER PRIMARY KEY, s VARCHAR)

statement ok
INSERT INTO keyed SELECT i, i::VARCHAR FROM range(400000) t(i)

statement ok
CREATE TABLE rolled_back AS SELECT i, i::VARCHAR AS s FROM range(400000) t(i)

statement ok
CHECKPOINT

statement ok
DELETE FROM a WHERE i < 300000 AND i % 10 <> 0

statement ok
DELETE FROM keyed WHERE i < 300000 AND i % 10 <> 0

statement ok
DELETE FROM rolled_back WHERE i < 300000 AND i % 10 <> 0

# nothing commits after the transactions start: the checkpoint is a full one
statement ok con1
BEGIN

statement ok con1
ALTER TABLE a ALTER s TYPE BIGINT USING s::BIGINT * 2

statement ok con1
ALTER TABLE keyed ALTER s TYPE BIGINT

statement ok con2
BEGIN

statement ok con2
ALTER TABLE rolled_back ALTER s TYPE BIGINT

# the merged row groups carry the computed column with its rows
statement ok
CHECKPOINT

# (older storage versions keep the row ids of a table with an index)
query II
SELECT (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('a')), (SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('rolled_back'))
----
2	2

query III con1
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i * 2) FROM a
----
130000	39499800000	130000

query II con1
SELECT i, s FROM keyed WHERE i = 350001
----
350001	350001

query III con2
SELECT COUNT(*), SUM(s), typeof(ANY_VALUE(s)) FROM rolled_back
----
130000	39499800000	BIGINT

query III
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR) FROM a
----
130000	39499800000	130000

statement ok con1
COMMIT

statement ok con2
ROLLBACK

query III
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i * 2) FROM a
----
130000	39499800000	130000

query I
SELECT COUNT(*) FROM a WHERE s >= 700000
----
50000

query II
SELECT i, s FROM keyed WHERE i = 350001
----
350001	350001

statement error
INSERT INTO keyed VALUES (350001, 0)
----
Duplicate key

query IIII
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR), typeof(ANY_VALUE(s)) FROM rolled_back
----
130000	39499800000	130000	VARCHAR

# the ALTERs replay from the WAL onto the merged row groups
restart

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i * 2) FROM a
----
130000	39499800000	130000

query III
SELECT i, s, typeof(s) FROM keyed WHERE i = 350001
----
350001	350001	BIGINT

query III
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i::VARCHAR) FROM rolled_back
----
130000	39499800000	130000

statement ok
CHECKPOINT

restart

statement ok
SET debug_verify_blocks=true

query III
SELECT COUNT(*), SUM(i), COUNT(*) FILTER (s = i * 2) FROM a
----
130000	39499800000	130000

query III
SELECT COUNT(*), SUM(s), typeof(ANY_VALUE(s)) FROM keyed
----
130000	39499800000	BIGINT

statement error
INSERT INTO keyed VALUES (350001, 0)
----
Duplicate key
