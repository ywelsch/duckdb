# name: test/sql/storage/vacuum_checkpoint_concurrent_delete_stress.test_slow
# description: Deletes, inserts, index scans and snapshots while checkpoints merge row groups
# group: [storage]

load {TEST_DIR}/vacuum_checkpoint_concurrent_delete_stress.db readwrite v2.1.0

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE test (i BIGINT PRIMARY KEY, j BIGINT, s VARCHAR);

statement ok
INSERT INTO test SELECT i, i % 1000, 'base' FROM range(1044480) t(i);

statement ok
CREATE INDEX idx_j ON test (j);

statement ok
CHECKPOINT

# thread 0 checkpoints, threads 1 to 3 delete, thread 4 inserts, threads 5 and 6 compare the indexes with the table,
# thread 7 holds a snapshot over several checkpoints, thread 8 thins out the table one range at a time, so that
# every checkpoint finds row groups to merge
concurrentloop threadid 0 9

loop x 0 40

onlyif threadid>0
statement ok
SELECT sleep_ms(20 + (random() * 40)::BIGINT)

# a row found through the primary key, and one whose delete is rolled back
onlyif threadid=1
statement ok
DELETE FROM test WHERE i = {x} * 20000

onlyif threadid=1
statement ok
BEGIN TRANSACTION

onlyif threadid=1
statement ok
DELETE FROM test WHERE i = {x} * 20000 + 900

onlyif threadid=1
statement ok
ROLLBACK

# about a thousand rows found through the other index
onlyif threadid=2
statement ok
DELETE FROM test WHERE j = {x} * 20 + 20

# nine rows found by a table scan
onlyif threadid=3
statement ok
DELETE FROM test WHERE abs(i) >= 800000 + {x} * 5000 AND abs(i) < 801000 + {x} * 5000 AND j > 800 AND i % 20 = 0

onlyif threadid=4
statement ok
INSERT INTO test SELECT 100000000 + {x} * 10000 + range, 1000 + {x}, 'new' FROM range(500)

# a row that is never deleted, and the rows the deleter of thread 2 is working on
onlyif threadid=5
query II
SELECT COUNT(*), min(s) FROM test WHERE i = {x} * 19000 + 900
----
1	base

onlyif threadid=5
query I
SELECT (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE j = {x} * 20 + 20) = (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE abs(j) = {x} * 20 + 20)
----
true

# the rows the inserter is working on, and rows of which the deleter of thread 3 removes one at a time
onlyif threadid=6
query I
SELECT (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE j = {x} + 1000) = (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE abs(j) = {x} + 1000)
----
true

onlyif threadid=6
query I
SELECT (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE j = 900) = (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE abs(j) = 900)
----
true

onlyif threadid=6
query I
SELECT (SELECT COUNT(*) FROM test WHERE i = 100000250 + {x} * 10000) = (SELECT COUNT(*) FROM test WHERE abs(i) = 100000250 + {x} * 10000)
----
true

# after the last iteration every row group has lost all but a twentieth of its rows
onlyif threadid=8
statement ok
DELETE FROM test WHERE i >= {x} * 26112 AND i < ({x} + 1) * 26112 AND i % 20 <> 0

onlyif threadid=7
statement ok
BEGIN TRANSACTION

onlyif threadid=7
statement ok
SET VARIABLE snapshot=(SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test)

loop y 0 4

# a checkpoint without changes in the WAL does nothing: the pause leaves the other threads time to write
onlyif threadid=0
statement ok
SELECT sleep_ms(50)

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=7
statement ok
SELECT sleep_ms(20 + (random() * 40)::BIGINT)

onlyif threadid=7
query I
SELECT CASE
	WHEN {'count': COUNT(*), 'sum': SUM(i)} = getvariable('snapshot')
	THEN NULL
	ELSE {'now': {'count': COUNT(*), 'sum': SUM(i)}, 'snapshot': getvariable('snapshot')}
	END
FROM test
----
NULL

endloop

onlyif threadid=7
statement ok
COMMIT

endloop

endloop

query III
SELECT COUNT(*), COUNT(*) = COUNT(DISTINCT rowid), COUNT(*) = COUNT(DISTINCT i) FROM test
----
30041	true	true

# both indexes agree with the table
loop k 0 60

query I
SELECT (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE j = {k} * 20) = (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE abs(j) = {k} * 20)
----
true

endloop

# the rows deleted through the primary key are gone, the ones whose delete was rolled back are not
loop k 0 40

query II
SELECT (SELECT COUNT(*) FROM test WHERE i = {k} * 20000), (SELECT COUNT(*) FROM test WHERE i = {k} * 20000 + 900)
----
0	1

endloop

restart

query III
SELECT COUNT(*), COUNT(*) = COUNT(DISTINCT rowid), COUNT(*) = COUNT(DISTINCT i) FROM test
----
30041	true	true

statement ok
INSERT INTO test VALUES (0, 0, 'again')

statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), COUNT(*) = COUNT(DISTINCT rowid), COUNT(*) = COUNT(DISTINCT i) FROM test
----
30042	true	true

loop k 0 60

query I
SELECT (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE j = {k} * 20) = (SELECT {'count': COUNT(*), 'sum': SUM(i)} FROM test WHERE abs(j) = {k} * 20)
----
true

endloop

statement error
INSERT INTO test VALUES (900, 900, 'duplicate')
----
<REGEX>:.*Constraint Error.*
