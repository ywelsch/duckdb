# name: test/sql/storage/vacuum_checkpoint_open_snapshot_in_memory.test_slow
# description: An in-memory checkpoint vacuums around the row group that an open snapshot sees differently
# group: [storage]

statement ok
SET checkpoint_threshold='1TB'

statement ok
CREATE TABLE test (i BIGINT);

# nine row groups, the last one is half full
statement ok
INSERT INTO test SELECT range FROM range(1044480);

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
9

# the first two row groups lose all rows, the others keep one row in a hundred
statement ok
DELETE FROM test WHERE i < 245760 OR i % 100 <> 0

# a new row group that the snapshot sees half of
statement ok
INSERT INTO test SELECT 1500000 + range FROM range(5000);

statement ok con2
BEGIN TRANSACTION

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
12987	12664911200

statement ok
INSERT INTO test SELECT 2000000 + range FROM range(5000);

statement ok
CHECKPOINT

# two row groups dropped, seven merged into one, the new one kept as it is
query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
2

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
12987	12664911200

query I con2
SELECT COUNT(*) FROM test WHERE i >= 2000000
----
0

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
17987	22677408700	true

statement ok con2
COMMIT

query II con2
SELECT COUNT(*), SUM(i) FROM test
----
17987	22677408700

# the next checkpoint merges the row group that was kept
statement ok
DELETE FROM test WHERE i = 2000000

statement ok
CHECKPOINT

query I
SELECT COUNT(DISTINCT row_group_id) FROM pragma_storage_info('test')
----
1

query III
SELECT COUNT(*), SUM(i), COUNT(*) = COUNT(DISTINCT rowid) FROM test
----
17986	22675408700	true
