# name: test/sql/storage/concurrent_checkpoint_ddl.test_slow
# description: DDL that does not rewrite or drop table storage commits while a checkpoint runs, and replays from the WAL
# group: [storage]

load {TEST_DIR}/concurrent_checkpoint_ddl.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
CREATE TABLE t (i INTEGER, j INTEGER);

statement ok
INSERT INTO t SELECT i, i FROM range(100000) t(i);

statement ok
CREATE VIEW v_old AS SELECT 1 AS one

statement ok
CREATE SEQUENCE seq

statement ok
CHECKPOINT

# the timing table lives in a database the checkpoint does not write
statement ok
ATTACH ':memory:' AS mem

statement ok
CREATE TABLE mem.timing (who VARCHAR, t TIMESTAMP);

# the checkpoint sleeps for three seconds before it scans the catalog, and for three seconds after it wrote table t
statement ok
SET debug_checkpoint_sleep_ms=3000

statement ok
SET debug_checkpoint_scan_sleep_ms=3000

concurrentloop threadid 0 4

# thread 3 is a reader that needs the state from before the insert below, so that this is a concurrent checkpoint
onlyif threadid=3
statement ok
BEGIN TRANSACTION

onlyif threadid=3
query I
SELECT COUNT(*) FROM t
----
100000

# thread 2 keeps a transaction with DDL and sequence use open across the whole checkpoint
onlyif threadid=2
statement ok
BEGIN TRANSACTION

onlyif threadid=2
statement ok
CREATE TABLE open_ddl AS SELECT nextval('seq') AS id FROM range(10)

sleep 500 millisecond

onlyif threadid=0
statement ok
INSERT INTO t VALUES (-1, -1)

onlyif threadid=0
statement ok
CHECKPOINT

onlyif threadid=0
statement ok
INSERT INTO mem.timing VALUES ('checkpoint end', now())

sleep 1000 millisecond

# during the sleep before the catalog scan
onlyif threadid=1
statement ok
CREATE TABLE created AS SELECT i FROM range(1000) t(i)

onlyif threadid=1
statement ok
CREATE TABLE pk (id INTEGER PRIMARY KEY)

onlyif threadid=1
statement ok
INSERT INTO pk SELECT i FROM range(1000) t(i)

onlyif threadid=1
statement ok
CREATE SCHEMA s2

onlyif threadid=1
statement ok
CREATE TYPE mood AS ENUM ('a', 'b')

onlyif threadid=1
statement ok
CREATE MACRO plus1(x) AS x + 1

onlyif threadid=1
statement ok
CREATE VIEW v_new AS SELECT plus1(41) AS answer

onlyif threadid=1
statement ok
DROP VIEW v_old

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('catalog ddl end', now())

sleep 3000 millisecond

# during the sleep after table t was written, before it is installed
onlyif threadid=1
statement ok
ALTER TABLE t RENAME TO t2

onlyif threadid=1
statement ok
ALTER TABLE t2 ALTER COLUMN j SET DEFAULT 5

onlyif threadid=1
statement ok
ALTER TABLE t2 ALTER COLUMN i SET NOT NULL

onlyif threadid=1
statement ok
COMMENT ON TABLE t2 IS 'renamed'

onlyif threadid=1
statement ok
INSERT INTO t2 (i) VALUES (100000)

onlyif threadid=1
statement ok
INSERT INTO pk VALUES (1000)

onlyif threadid=1
statement ok
INSERT INTO mem.timing VALUES ('write ddl end', now())

sleep 3000 millisecond

onlyif threadid=2
statement ok
INSERT INTO open_ddl SELECT nextval('seq')

onlyif threadid=2
statement ok
COMMIT

onlyif threadid=3
statement ok
COMMIT

endloop

# the DDL did not wait for the checkpoint
query I
SELECT (SELECT t FROM mem.timing WHERE who = 'catalog ddl end') < (SELECT t FROM mem.timing WHERE who = 'checkpoint end') - INTERVAL 2 SECOND
----
true

query I
SELECT (SELECT t FROM mem.timing WHERE who = 'write ddl end') < (SELECT t FROM mem.timing WHERE who = 'checkpoint end')
----
true

statement ok
SET debug_checkpoint_sleep_ms=0

statement ok
SET debug_checkpoint_scan_sleep_ms=0

loop k 0 2

query III
SELECT COUNT(*), SUM(i), SUM(j) FROM t2
----
100002	5000049999	4999950004

statement error
INSERT INTO t2 VALUES (NULL, 1)
----
NOT NULL constraint failed

query T
SELECT comment FROM duckdb_tables() WHERE table_name = 't2'
----
renamed

query II
SELECT COUNT(*), SUM(i) FROM created
----
1000	499500

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM pk
----
1001	1001

statement error
INSERT INTO pk VALUES (7)
----
violates primary key constraint

query I
SELECT COUNT(*) FROM pk WHERE id = 7
----
1

query I
SELECT answer FROM v_new
----
42

query I
SELECT COUNT(*) FROM duckdb_views() WHERE view_name = 'v_old'
----
0

query I
SELECT COUNT(*) FROM duckdb_schemas() WHERE schema_name = 's2'
----
1

query I
SELECT 'a'::mood
----
a

query II
SELECT COUNT(*), MAX(id) FROM open_ddl
----
11	11

query I
SELECT nextval('seq') > 11
----
true

restart

endloop

statement ok
CHECKPOINT

restart

query III
SELECT COUNT(*), SUM(i), SUM(j) FROM t2
----
100002	5000049999	4999950004

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM pk
----
1001	1001
