# name: test/sql/copy/parquet/batched_write/batch_copy_union_partial_row_groups.test
# description: An order-preserving COPY of a UNION ALL ends the partial row group of a branch when the next branch starts with a full one
# group: [batched_write]

require parquet

statement ok
SET threads=4;

loop i 0 3

statement ok
COPY (SELECT ${i} * 256000 + j AS k FROM range(256000) t(j)) TO '{TEST_DIR}/union_partial_${i}.parquet' (FORMAT parquet, ROW_GROUP_SIZE 102400);

endloop

# every branch reads row groups of 102400, 102400 and 51200 rows: the last one is not merged with the first row group
# of the next branch, which would shift all following rows
statement ok
COPY (
	FROM '{TEST_DIR}/union_partial_0.parquet' UNION ALL
	FROM '{TEST_DIR}/union_partial_1.parquet' UNION ALL
	FROM '{TEST_DIR}/union_partial_2.parquet'
) TO '{TEST_DIR}/union_partial.parquet' (FORMAT parquet, PRESERVE_ORDER, ROW_GROUP_SIZE 102400);

query I
SELECT list(row_group_num_rows ORDER BY row_group_id) FROM parquet_metadata('{TEST_DIR}/union_partial.parquet');
----
[102400, 102400, 51200, 102400, 102400, 51200, 102400, 102400, 51200]

query II
SELECT count(*), bool_and(k = file_row_number) FROM read_parquet('{TEST_DIR}/union_partial.parquet', file_row_number = true);
----
768000	true

# branches smaller than a row group are still merged
statement ok
COPY (
	SELECT 0 AS k UNION ALL
	SELECT 1 UNION ALL
	SELECT 2 UNION ALL
	SELECT 3
) TO '{TEST_DIR}/union_small.parquet' (FORMAT parquet, PRESERVE_ORDER);

query II
SELECT count(*), list(row_group_num_rows) FROM parquet_metadata('{TEST_DIR}/union_small.parquet');
----
1	[4]
