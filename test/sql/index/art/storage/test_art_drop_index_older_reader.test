# name: test/sql/index/art/storage/test_art_drop_index_older_reader.test
# description: A dropped index stays usable for an older reader while checkpoints free its blocks
# group: [storage]

load {TEST_DIR}/art_drop_index_older_reader.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE t (i INTEGER, j INTEGER);

statement ok
INSERT INTO t SELECT range, range FROM range(200000);

statement ok
CREATE INDEX idx ON t(i);

statement ok
CHECKPOINT

statement ok con1
BEGIN

query I con1
SELECT count(*) FROM t WHERE i = 42
----
1

statement ok con2
DROP INDEX idx

query I con1
SELECT count(*) FROM t WHERE i = 42
----
1

# the drop gave up the index's blocks: the header lists them as free, but they are not reused while con1 is active
statement ok con2
CHECKPOINT

statement ok con2
INSERT INTO t SELECT range, range FROM range(200000, 400000);

statement ok con2
CHECKPOINT

query I con1
SELECT count(*) FROM t WHERE i = 42
----
1

statement ok con1
COMMIT

statement ok
CHECKPOINT

query I
SELECT count(*) FROM duckdb_indexes()
----
0

restart

query I
SELECT count(*) FROM t WHERE i = 42
----
1

statement ok
SET debug_verify_blocks=true

statement ok
CREATE INDEX idx ON t(i);

statement ok
CHECKPOINT

query I
SELECT count(*) FROM t WHERE i = 42
----
1
