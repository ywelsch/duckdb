# name: test/sql/tpcds/dsdgen_checkpoint_lock.test
# description: dsdgen, whose tables have primary keys, in a transaction that is open across a checkpoint, and replay from the WAL
# group: [tpcds]

require tpcds

require skip_reload

load {TEST_DIR}/dsdgen_checkpoint_lock.db

statement ok
SET checkpoint_threshold='1TB'

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET debug_verify_blocks=true

statement ok
CREATE TABLE tick (i INTEGER)

statement ok
CHECKPOINT

statement ok con1
BEGIN TRANSACTION

statement ok con1
CALL dsdgen(sf=0.01, keys=true)

statement ok
INSERT INTO tick VALUES (1)

statement ok
CHECKPOINT

statement ok con1
COMMIT

restart

statement ok
SET debug_verify_blocks=true

statement error
INSERT INTO item SELECT * FROM item LIMIT 1
----
Duplicate key

statement ok
INSERT INTO tick VALUES (2)

statement ok
CHECKPOINT

restart

statement error
INSERT INTO item SELECT * FROM item LIMIT 1
----
Duplicate key
