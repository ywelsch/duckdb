# name: test/sql/transactions/commit_append_failure_fatal.test
# description: Commit-time append failures that cannot be reverted reliably invalidate the database, and the database is intact after a restart
# group: [transactions]

# Each case deliberately invalidates the database and restarts it.
require no_alternative_verify

require skip_reload

load {TEST_DIR}/commit_append_failure_fatal.db

statement ok
CREATE TABLE t (a INTEGER, b VARCHAR, v INTEGER, PRIMARY KEY (a, b));

statement ok
INSERT INTO t SELECT i, 'k' || i, i FROM range(10000) r(i);

statement ok
CHECKPOINT

# --- the index append fails with an error other than a constraint violation ---

statement ok
SET debug_force_commit_append_failure = 'INDEX_APPEND';

statement ok
BEGIN

statement ok
DELETE FROM t WHERE a >= 7000;

statement ok
INSERT INTO t SELECT i, 'k' || i, -1 FROM range(7000, 15000) r(i);

statement error
COMMIT
----
appending to the indexes of table "t" failed, leaving them in an inconsistent state

statement error
SELECT count(*) FROM t
----
database has been invalidated

restart

statement ok
SET debug_force_commit_append_failure = 'NONE';

query III
SELECT count(*), count(DISTINCT (a, b)), count(*) FILTER (v = -1) FROM t
----
10000	10000	0

statement ok
INSERT INTO t VALUES (12345, 'k12345', 0);

statement error
INSERT INTO t VALUES (7000, 'k7000', 0);
----
<REGEX>:Constraint Error.*violates primary key constraint.*

statement ok
DELETE FROM t WHERE a = 12345;

# --- merging bulk-appended row groups into the table fails ---

statement ok
SET debug_force_commit_append_failure = 'MERGE_STORAGE';

statement ok
BEGIN

statement ok
INSERT INTO t SELECT i, 'k' || i, -1 FROM range(100000, 300000) r(i);

statement error
COMMIT
----
merging the appended rows into table "t" failed

restart

statement ok
SET debug_force_commit_append_failure = 'NONE';

query III
SELECT count(*), count(DISTINCT (a, b)), count(*) FILTER (v = -1) FROM t
----
10000	10000	0

statement ok
INSERT INTO t VALUES (100000, 'k100000', 0);

statement ok
DELETE FROM t WHERE a = 100000;

# --- the table append fails and removing the appended index entries fails too ---

statement ok
SET debug_force_commit_append_failure = 'TABLE_APPEND';

statement ok
SET debug_force_commit_revert_failure = true;

statement ok
BEGIN

statement ok
DELETE FROM t WHERE a >= 7000;

statement ok
INSERT INTO t SELECT i, 'k' || i, -1 FROM range(7000, 15000) r(i);

# the error reports both the original failure and the failed revert
statement error
COMMIT
----
<REGEX>:.*Forced table append failure.*\n.*Could not remove the appended entries from the indexes of table "t" afterwards.*Forced index revert failure.*

restart

statement ok
SET debug_force_commit_append_failure = 'NONE';

statement ok
SET debug_force_commit_revert_failure = false;

query III
SELECT count(*), count(DISTINCT (a, b)), count(*) FILTER (v = -1) FROM t
----
10000	10000	0

# the upsert succeeds
statement ok
BEGIN

statement ok
DELETE FROM t WHERE a >= 7000;

statement ok
INSERT INTO t SELECT i, 'k' || i, -1 FROM range(7000, 15000) r(i);

statement ok
COMMIT

query III
SELECT count(*), count(DISTINCT (a, b)), count(*) FILTER (v = -1) FROM t
----
15000	15000	8000
